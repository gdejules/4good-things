---
import Image from "astro/components/Image.astro";
import "../styles/global.css";
import MenuButton from "./MenuButton.astro";
import logo from "/src/assets/4goodthings-logo.png";
---

<nav class="w-auto h-auto px-16 py-5 bg-warm-alabaster">
  <div class="flex justify-between items-center">
    <MenuButton>
      <a href="/">
        <Image
          src={logo}
          alt="4GoodThings Logo"
          layout="constrained"
          width={80}
          class="max-w-32 min-w-10 h-auto"
        />
      </a>
    </MenuButton>
    <div class="flex justify-between items-center gap-3 max-md:hidden">
      <MenuButton><a href="/product"> Product </a></MenuButton>
      <MenuButton><a href="/project"> Project </a></MenuButton>
      <MenuButton><a href="/about"> About </a></MenuButton>
    </div>
    <MenuButton>
      <a href="" class="flex gap-2 items-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round">
          <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path>
          <path
            d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
          ></path>
        </svg>
        <span class="max-md:hidden">Contact Us</span>
      </a>
    </MenuButton>
  </div>
</nav>
