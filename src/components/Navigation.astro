---
import "../styles/global.css";
import MenuButton from "./MenuButton.astro";
---

<div class="w-full h-auto px-16 py-5 bg-transparent">
  <div class="flex justify-between items-center gap-40">
    <MenuButton>
      <a href="/" class="shrink-0" aria-label="4GoodThings - Home">
        <img
          src="/4goodthings-logo-center_1.png"
          alt="4GoodThings Logo"
          width="100"
        />
      </a>
    </MenuButton>
    <div class="flex justify-between items-center gap-10">
      <MenuButton><a href="/product"> Product </a></MenuButton>
      <MenuButton><a href="/project"> Project </a></MenuButton>
      <MenuButton><a href="/about"> About </a></MenuButton>
    </div>
    <MenuButton>
      <a href="" class="flex gap-2 items-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round">
          <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path>
          <path
            d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
          ></path>
        </svg>
        <span>Contact Us</span>
      </a>
    </MenuButton>
  </div>
</div>
