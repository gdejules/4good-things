---
import "../styles/global.css";
---

<div class="w-full h-auto px-24 py-3 bg-green">
  <div class="flex justify-between items-center gap-40">
    <a href="/" class="flex-shrink-0" aria-label="4GoodThings - Home"
      ><img
        src="/4goodthings-logo-center_1.png"
        alt="4GoodThings Logo"
        width="100"
      /></a
    >
    <div class="flex justify-between items-center gap-10">
      <a
        href="/product"
        class="menu uppercase text-white border-b-2 border-[#00000000] hover:text-honey hover:border-b-2 hover:border-honey">
        Product</a
      >
      <a
        href="/project"
        class="menu uppercase text-white border-b-2 border-[#00000000] hover:text-honey hover:border-b-2 hover:border-honey">
        Project</a
      >
      <a
        href="/about"
        class="menu uppercase text-white border-b-2 border-[#00000000] hover:text-honey hover:border-b-2 hover:border-honey">
        About</a
      >
    </div>
  </div>
</div>
