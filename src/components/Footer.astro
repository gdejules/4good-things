---
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "/public/4goodthings-logo-center_1.png";
import { SocialButton } from "./CustomAwesomeButton";

const whatsappButton = {
  href: "https://wa.me/6281113805807?text=Hi%20I'm%20interested%20in%20your%20products",
  type: "whatsapp",
  size: "small",
  active: false,
};

const instaButton = {
  href: "https://www.instagram.com/4goodthings_/",
  type: "instagram",
  size: "small",
  active: false,
};

const mailButton = {
  href: "mailto:weare4goodthings@gmail.com",
  type: "mail",
  size: "small",
  active: false,
};
---

<footer class="section pt-20 pb-10 bg-forest-shadow">
  <div class="w-auto flex flex-col gap-custom-xl items-center">
    <div
      class="max-w-6xl mx-auto grid grid-cols-12 grid-rows-1 gap-x-custom-l gap-y-custom-xl max-md:flex max-md:flex-col max-md:gap-custom-xl max-md:items-center max-md:mx-6 max-xl:mx-10 max-lg:flex">
      <div class="col-span-3 col-end-4 row-end-1 max-lg:grow-0">
        <Image
          class="object-cover object-center w-60 aspect-auto rounded-lg"
          src={logo}
          widths={[240, 320]}
          sizes={`(max-width: 360px) 240px, (max-width: 1200px) 320px`}
          alt="4GoodThings'
          logo"
        />
      </div>
      <div
        class="col-start-4 col-span-3 row-end-1 flex flex-col gap-custom-xs max-sm:items-center max-lg:flex-1 max-md:items-center">
        <span
          class="text-pure-white font-body text-body-normal font-normal uppercase tracking-wider"
          >Navigate</span
        >
        <ul
          class="flex flex-col gap-custom-s text-pure-white font-body text-body-large font-medium tracking-widest max-sm:items-center">
          <li><a href="/about"> About </a></li>
          <li><a href="/product"> Product </a></li>
          <li><a href="/project"> Project </a></li>
        </ul>
      </div>
      <div
        class="col-start-9 col-span-4 row-end-1 flex flex-col gap-custom-s max-lg:flex-1 max-md:items-center">
        <div
          class="flex flex-col gap-custom-2xs max-md:items-center max-lg:items-center">
          <span class="text-pure-white font-display text-heading-small">
            let’s create impact together!
          </span>
          <span
            class="text-pure-white font-body text-body-normal max-md:text-center">
            Contact us for more information and follow along to see our journey.
          </span>
        </div>
        <div class="flex gap-custom-m">
          <SocialButton
            client:load
            type={whatsappButton.type}
            href={whatsappButton.href}
            size={whatsappButton.size}
            active={whatsappButton.active}
          />
          <SocialButton
            client:load
            type={instaButton.type}
            href={instaButton.href}
            size={instaButton.size}
            active={instaButton.active}
          />
          <SocialButton
            client:load
            type={mailButton.type}
            href={mailButton.href}
            size={mailButton.size}
            active={mailButton.active}
          />
        </div>
      </div>
    </div>
    <div class="text-pure-white font-body font-normal text-body-normal">
      ©2026 4GoodThings
    </div>
  </div>
</footer>
