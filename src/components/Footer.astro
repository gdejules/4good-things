---
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "/public/4goodthings-logo-center_1.png";
import MenuButtonAstroComponent from "./MenuButton.astro";
---

<footer class="section pt-20 pb-10 bg-forest-shadow">
  <div class="w-auto flex flex-col gap-6 items-center">
    <div
      class="max-w-6xl mx-auto grid grid-cols-12 grid-rows-1 gap-x-custom-m gap-y-custom-xl max-md:flex max-md:flex-col max-md:gap-custom-xl max-md:items-center max-md:mx-6 max-xl:mx-10 max-lg:flex max-lg:flex-wrap">
      <div class="col-span-2 col-end-3 row-end-1 max-lg:grow-0">
        <Image
          class="object-cover object-center w-60 aspect-auto rounded-lg"
          src={logo}
          widths={[240, 320]}
          sizes={`(max-width: 360px) 240px, (max-width: 1200px) 320px`}
          alt="4GoodThings'
          logo"
        />
      </div>
      <div
        class="col-start-3 col-span-6 grid grid-cols-6 max-sm:flex max-sm:flex-col max-sm:gap-custom-xl max-md:w-full max-md:flex max-md:flex-row max-md:justify-between max-lg:flex-1 max-lg:gap-x-custom-s">
        <div
          class="col-span-2 col-end-3 row-end-1 flex flex-col gap-2 max-md:flex-1">
          <span
            class="text-cream font-body text-body-normal font-medium uppercase tracking-wider"
            >Navigate</span
          >
          <ul
            class="flex flex-col gap-3 text-pure-white font-body text-body-normal font-normal tracking-widest">
            <li><a href="/about"> About </a></li>
            <li><a href="/product"> Product </a></li>
            <li><a href="/project"> Project </a></li>
          </ul>
        </div>
        <div
          class="col-span-4 col-end-7 row-end-1 flex flex-col gap-2 max-md:flex-2">
          <span
            class="text-cream font-body text-body-normal font-medium uppercase tracking-wider"
            >Contacts</span
          >
          <ul
            class="flex flex-col gap-3 text-pure-white font-body text-body-normal font-normal tracking-widest">
            <li class="flex gap-1">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram shrink-0 w-6 h-6"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8"
                ></path><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"
                ></path><path d="M16.5 7.5v.01"></path></svg
              >
              <span>@4goodthings_</span>
            </li>
            <li class="flex gap-1">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-mail shrink-0 w-6 h-6"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"
                ></path><path d="M3 7l9 6l9 -6"></path></svg
              >
              <span>weare4goodthings@gmail.com</span>
            </li>
            <li class="flex gap-1">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp shrink-0 w-6 h-6"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path><path
                  d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
                ></path></svg
              >
              <span>+62 8111 380 5807</span>
            </li>
          </ul>
        </div>
      </div>
      <div
        class="col-start-9 col-span-4 row-end-1 flex flex-col gap-custom-s max-md:flex-1 max-lg:w-full max-lg:items-center">
        <div
          class="flex flex-col gap-custom-2xs max-md:items-center max-lg:items-center">
          <span class="text-pure-white font-display text-heading-small">
            let’s create impact together!
          </span>
          <span
            class="text-cream font-body text-body-normal max-lg:text-center">
            We are always open for new collaborations or projects. Let’s
            connect!
          </span>
        </div>
        <div class="flex gap-custom-l">
          <MenuButtonAstroComponent>
            <a href="" class="flex gap-custom-2xs items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path><path
                  d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
                ></path></svg
              >
              <span>Whatsapp</span>
            </a>
          </MenuButtonAstroComponent>
          <MenuButtonAstroComponent>
            <a href="" class="flex gap-custom-2xs items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-mail"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"
                ></path><path d="M3 7l9 6l9 -6"></path></svg
              >
              <span>Email</span>
            </a>
          </MenuButtonAstroComponent>
        </div>
      </div>
    </div>
    <div class="text-pure-white font-body font-normal text-body-normal">
      ©2026 4GoodThings
    </div>
  </div>
</footer>
