---
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "/public/4goodthings-logo-center_1.png";
import MenuButtonAstroComponent from "./MenuButton.astro";
---

<footer class="w-full h-auto px-16 py-5 bg-forest-shadow">
  <div class="grid grid-cols-8 grid-rows-6">
    <div class="left col-span-5 row-span-5 flex gap-3">
      <div class="logo flex-1">
        <Image src={logo} alt="4GoodThings logo" />
      </div>
      <div class="nav flex-1 flex flex-col">
        <span class="text-pure-white font-display text-base">Navigate</span>
        <span class="text-pure-white font-body text-lg"
          ><a href="/about"> About </a></span
        >
        <span class="text-pure-white font-body text-lg"
          ><a href="/product"> Product </a></span
        >
        <span class="text-pure-white font-body text-lg"
          ><a href="/project"> Project </a></span
        >
      </div>
      <div class="contacts flex-2 flex flex-col">
        <span class="text-pure-white font-display text-base">Contacts</span>
        <div class="flex-1 flex gap-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"
            ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
              d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8"
            ></path><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path><path
              d="M16.5 7.5v.01"></path></svg
          >
          <span class="text-pure-white font-body text-lg">@4goodthings_</span>
        </div>
        <div class="flex-1 flex gap-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-mail"
            ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
              d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"
            ></path><path d="M3 7l9 6l9 -6"></path></svg
          >
          <span class="text-pure-white font-body text-lg"
            >weare4goodthings@gmail.com</span
          >
        </div>
        <div class="flex-1 flex gap-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp"
            ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
              d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path><path
              d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
            ></path></svg
          >
          <span class="text-pure-white font-body text-lg"
            >+62 8111 380 5807</span
          >
        </div>
      </div>
    </div>
    <div class="cta col-start-6 col-span-3 row-span-5">
      <div class="title text-pure-white font-display text-2xl">
        let’s create impact together!
      </div>
      <div class="subtitle text-cream font-body text-xl">
        We are always open for new collaborations or projects. Let’s connect!
      </div>
      <div class="contact-buttons flex gap-3">
        <MenuButtonAstroComponent>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp"
            ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
              d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path><path
              d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
            ></path></svg
          >
          <span>Whatsapp</span>
        </MenuButtonAstroComponent>
        <MenuButtonAstroComponent>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-mail"
            ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
              d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10"
            ></path><path d="M3 7l9 6l9 -6"></path></svg
          >
          <span>Email</span>
        </MenuButtonAstroComponent>
      </div>
    </div>
    <div class="copyright col-span-8 row-start-6">©2026 4GoodThings</div>
  </div>
</footer>
