---
import "../styles/global.css";
---

<div class="w-full h-auto py-14 px-24 bg-green/[0.2]">
  <div class="flex flex-col justify-start items-center gap-14">
    <div class="flex-1 flex flex-col justify-start gap-4">
      <h2 class="w-3/4">
        Collaborathings, our collaboration project with uniquely-designed
        process and products
      </h2>
      <p class="text-xl w-3/4">Journey of circular economy starts here</p>
      <div class="flex justify-between w-full">
        <h3 class="w-3/4">Featured Collaborathings</h3>
        <a
          href="/about"
          class="flex-shrink-0 flex items-center text-black hover:text-orange hover:underline">
          <span class="font-mono text-sm uppercase">
            See All Projects <span class="font-mono text-xl">→</span>
          </span>
        </a>
      </div>
    </div>
    <div class="flex justify-between items-start gap-12 w-full">
      <div class="flex justify-between w-2/3">
        <img
          class="object-cover object-center w-64 h-64 rounded-lg border-2 border-solid border-white"
          src="/collab/aloha/aloha-table1.jpeg"
          alt="a table made from recycled plastics"
          width="64"
        />
        <img
          class="object-cover object-center w-64 h-64 rounded-lg border-2 border-solid border-white"
          src="/collab/aloha/aloha-table2.JPG"
          alt="a table made from recycled plastics"
          width="64"
        />
        <img
          class="object-cover object-center w-64 h-64 rounded-lg border-2 border-solid border-white"
          src="/collab/aloha/aloha-misc.jpeg"
          alt="coasters made from recycled plastics"
          width="64"
        />
      </div>
      <div class="flex flex-col justify-start items-start w-1/3 gap-4">
        <h4 class="font-bold text-green">4GoodThings with Aloha</h4>
        <p>
          From post-consumer plastic packaging to tabletops, installed in
          Aloha’s main hall
        </p>
        <p>± 26 kg of plastic packagings recycled</p>
      </div>
    </div>
    <div
      class="flex flex-row-reverse justify-between items-start gap-12 w-full">
      <div class="flex justify-between w-2/3">
        <img
          class="object-cover object-center w-64 h-64 rounded-lg border-2 border-solid border-white"
          src="/collab/petronas/petronas-rack1.jpeg"
          alt="a rack made from recycled plastics"
          width="64"
        />
        <img
          class="object-cover object-center w-64 h-64 rounded-lg border-2 border-solid border-white"
          src="/collab/petronas/petronas-rack2.jpeg"
          alt="a rack made from recycled plastics"
          width="64"
        />
        <img
          class="object-cover object-center w-64 h-64 rounded-lg border-2 border-solid border-white"
          src="/collab/petronas/petronas-rack3.jpeg"
          alt="a rack made from recycled plastics"
          width="64"
        />
      </div>
      <div class="flex flex-col justify-start items-start w-1/3 gap-4">
        <h4 class="font-bold text-green">4GoodThings with Petronas</h4>
        <p>From expired safety helmets to coasters.</p>
        <p>± 20 kg of plastic packagings recycled</p>
      </div>
    </div>
    <div class="flex flex-col items-center gap-6">
      <h2>Our Collaborators</h2>
      <div class="flex justify-center items-center gap-20">
        <span class="text-base font-medium">Company Logo 1</span>
        <span class="text-base font-medium">Company Logo 1</span>
        <span class="text-base font-medium">Company Logo 1</span>
      </div>
    </div>
  </div>
</div>
