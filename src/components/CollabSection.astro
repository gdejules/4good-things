---
import "../styles/global.css";
import { getCollection } from "astro:content";
import CollabCard from "./CollabCard.astro";

const featuredCollaborathings = await getCollection("projects", ({ data }) => {
  return data.type === "collaborathing";
});
---

<div class="w-full h-auto pt-20 pb-40 px-24 bg-warm-alabaster">
  <div class="flex flex-col justify-start gap-14">
    <div class="flex-1 flex flex-col justify-start gap-4">
      <span class="font-display text-lg md:text-2xl text-muted-moss"
        >Our projects</span
      >
      <h2
        class="w-3/4 font-display text-2xl md:text-6xl text-deep-pine-charcoal">
        Collaborathings: Your journey of circular economy starts here
      </h2>
      <p class="w-3/4 font-body text-lg md:text-2xl text-muted-moss">
        Collaborathings is our collaboration projects with uniquely-designed
        process and products
      </p>
    </div>
    <div class="flex flex-col gap-6">
      <div class="flex justify-between w-full mb-5">
        <h3
          class="w-3/4 font-display text-xl md:text-3xl text-deep-pine-charcoal">
          Featured Collaborathings
        </h3>
        <a
          href="/about"
          class="shrink-0 flex items-center text-deep-pine-charcoal hover:text-orange hover:underline">
          <span class="font-body text-base uppercase">
            See All Projects <span class="font-body text-xl">→</span>
          </span>
        </a>
      </div>
      <div class="flex flex-col gap-10">
        {featuredCollaborathings.map((p) => <CollabCard project={p} />)}
      </div>
    </div>
  </div>
</div>
