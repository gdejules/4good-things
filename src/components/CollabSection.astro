---
import "../styles/global.css";
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import Button from "./Button.astro";
import { PrimaryButton } from "./CustomAwesomeButton";

const seeMoreProjectButton = {
  children: "See more",
  href: "/project",
  className: "project-content",
  size: "large",
  active: false,
};

const featuredProjects = await getCollection("projects", ({ data }) => {
  return data.featured === true;
});
---

<section class="section py-20 bg-warm-alabaster">
  <div
    class="max-w-6xl mx-auto flex flex-col justify-start items-center gap-custom-xl-2xl max-md:mx-6 max-xl:mx-10">
    <div class="flex-1 flex flex-col justify-start gap-custom-xs">
      <h2
        class="font-body font-medium text-heading-small uppercase text-muted-moss">
        Our projects
      </h2>
      <span
        class="font-display text-heading-large max-w-text-heading-large text-deep-pine-charcoal">
        We help enterprises and institutions in their circular economy journey
      </span>
      <p
        class="font-body text-body-normal max-w-text-body-normal text-muted-moss">
        We are fostering impactful collaborations through collaborathings, a
        tailored and unique initiative, and also general projects, an end-to-end
        recycling collaboration.
      </p>
    </div>
    <div class="flex flex-col gap-custom-m-l">
      <h3
        class="font-display text-heading-small max-w-text-heading-small text-deep-pine-charcoal">
        Featured Collaborations
      </h3>
      <div
        class="grid grid-cols-12 auto-rows-auto gap-x-custom-2xs gap-y-custom-xl">
        {
          featuredProjects.length > 0 ? (
            featuredProjects.map((p) => <ProjectCard project={p} />)
          ) : (
            <p class="col-start-1 col-span-12 font-body text-body-normal text-muted-moss my-custom-xl">
              No featured collaborations available yet.
            </p>
          )
        }
      </div>
    </div>
    <PrimaryButton
      client:load
      transition:persist
      href={seeMoreProjectButton.href}
      active={seeMoreProjectButton.active}
      size={seeMoreProjectButton.size}>
      {seeMoreProjectButton.children}
    </PrimaryButton>
  </div>
</section>
