---
import "../styles/global.css";
import { Picture } from "astro:assets";
import alohaPlastics from "/src/assets/collab/aloha/aloha-plastics.png";
import alohaPressing from "/src/assets/collab/aloha/aloha-pressing.png";
import alohaProduct from "/src/assets/collab/aloha/aloha-product.png";
---

<div id="brand-highlight" class="w-full h-auto px-24 py-28 bg-lightGreen">
  <div
    class="grid grid-rows-[min-content_minmax(280px,_1fr)_min-content] gap-16">
    <div class="grid grid-cols-3 items-start gap-8">
      <div class="grid grid-rows-3">
        <span class="row-start-2 text-2xl font-semibold text-green"
          >The world is producing 430 million tonnes of plastic per year.</span
        >
      </div>
      <div class="flex flex-col gap-3">
        <span class="highlight text-dark"
          >5th largest contributor to plastic waste</span
        >
        <span class="text-xl">
          Indonesia is world's fifth-largest contributor to plastic waste in the
          ocean. More than 60% of the total plastic waste is mismanaged.
        </span>
        <span class="text-sm">IUCN NL (2025)</span>
      </div>
      <div class="flex flex-col gap-3">
        <span class="highlight text-dark"
          >46% of plastic waste is landfilled.</span
        >
        <span class="text-xl">
          Plastic makes up the biggest, and most harmful, representing at least
          85% of total marine waste.
        </span>
        <span class="text-sm">un.org (2023)</span>
      </div>
    </div>
    <div
      class="grid grid-cols-3 justify-items-center items-center border-t-2 border-b-2 border-green/[0.15] py-10">
      <div class="flex flex-col items-start gap-4">
        <span class="highlight text-dark">
          4GoodThings is where plastic waste stops being trash and starts
          becoming something that matters.
        </span>
        <a
          href="/about"
          class="flex-shrink-0 flex items-center text-black hover:text-orange hover:underline">
          <span class="font-mono text-sm uppercase">
            About Us <span class="font-mono text-xl">→</span>
          </span>
        </a>
      </div>
      <Picture
        class="object-cover object-center w-64 h-64 rounded-lg border-2 border-solid border-white"
        src={alohaPressing}
        formats={["avif", "webp"]}
        alt="Plastic shreds are molded and pressed to be plastic sheet."
      />
      <Picture
        class="object-cover object-center w-64 h-64 rounded-lg border-2 border-solid border-white"
        src={alohaProduct}
        formats={["avif", "webp"]}
        alt="A light-colored round table made from recycled plastics surrounded by four chairs."
      />
    </div>
    <div class="grid grid-cols-3 items-start gap-8">
      <div>
        <span class="text-2xl font-semibold text-green"
          >We focus on reducing plastic waste that ends up in the ocean and
          landfills.</span
        >
      </div>
      <div class="flex flex-col gap-3">
        <span class="highlight text-dark">14.433 kg</span>
        <span class="text-xl">
          Amount of plastic waste that we have recycled per November 2025.
        </span>
      </div>
      <div class="flex flex-col gap-3">
        <span class="highlight text-dark">3.946.667 pieces</span>
        <span class="text-xl">
          Total of mixed plastic bottle waste that we have been collected so
          far.
        </span>
      </div>
    </div>
  </div>
</div>
