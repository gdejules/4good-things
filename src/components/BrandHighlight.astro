---
import "../styles/global.css";
import { Image } from "astro:assets";
import alohaTrash from "/src/assets/highlight/aloha-trash-3.jpeg";
import alohaPressing from "/src/assets/collab/aloha/aloha-pressing.png";
import { PrimaryButton } from "./CustomAwesomeButton";
import { getCollection } from "astro:content";
import StatCard from "./StatCard.astro";

const learnMoreButton = {
  children: "Learn more",
  href: "/about",
  className: "about-content",
  size: "large",
  active: false,
};

const allStats = await getCollection("stats");
---

<section id="brand-highlight" class="section flex flex-col gap-custom-xl-2xl">
  <div class="bg-soft-sand">
    <div
      class="max-w-6xl mx-auto py-custom-3xl flex flex-col gap-custom-xs max-md:mx-6 max-xl:mx-10">
      <h2
        class="about-us font-body font-medium text-body-large uppercase text-muted-moss">
        About us
      </h2>
      <h3
        class="highlight-text text-heading-super max-w-text-heading-super tracking-wider text-deep-pine-charcoal">
        <span class="text-green">4GoodThings</span> is where plastic waste <span
          class="text-green">stop being trash</span
        > and starts becoming <span class="text-green"
          >something that matters.</span
        >
      </h3>
    </div>
  </div>
  <div
    class="max-w-6xl mx-auto grid grid-cols-12 grid-rows-1 auto-rows-auto gap-x-custom-2xs items-center max-md:flex max-md:flex-col max-md:gap-custom-s max-md:mx-6 max-xl:mx-10">
    <h3
      class="col-span-12 row-span-1 row-end-2 text-heading-medium max-w-text-heading-medium text-orange max-md:text-center">
      the world is producing 430 million tonnes of plastic per year
    </h3>
    <div
      class="order-1 col-span-6 col-end-7 row-span-1 row-end-3 px-custom-l-xl py-custom-l-xl max-md:px-custom-s-l">
      <Image
        class="object-cover object-center w-full aspect-auto rounded-2xl -rotate-6 shadow-tl-solid-honey"
        src={alohaTrash}
        alt="plastic glass trashes"
        layout="constrained"
        format="webp"
      />
    </div>
    <div
      class="order-2 col-span-6 col-end-13 row-span-1 row-end-3 flex flex-col gap-custom-m">
      <div
        class="flex flex-col gap-custom-2xs font-body py-custom-xs-s px-custom-s-m rounded-2xl shadow-soft-tl-solid-soft-sand">
        <span
          class="text-body-large max-w-text-body-large font-bold text-deep-pine-charcoal max-md:text-center"
          >46% of plastic waste is landfilled.</span
        >
        <span
          class="text-body-normal max-w-text-body-normal font-normal text-deep-pine-charcoal max-md:text-center"
          >Plastic makes up the biggest, and most harmful, representing at least
          85% of total marine waste.</span
        >
        <span
          class="text-body-small max-w-text-body-small font-medium text-muted-moss text-end max-md:text-center"
          >un.org (2023)</span
        >
      </div>
      <div
        class="flex flex-col gap-custom-2xs font-body py-custom-xs-s px-custom-s-m rounded-2xl shadow-soft-tl-solid-soft-sand">
        <span
          class="text-body-large max-w-text-body-large font-bold text-deep-pine-charcoal max-md:text-center"
          >Indonesia is world's fifth-largest contributor to plastic waste in
          the ocean.</span
        >
        <span
          class="text-body-normal max-w-text-body-normal font-normal text-deep-pine-charcoal max-md:text-center"
          >More than 60% of the total plastic waste is mismanaged.</span
        >
        <span
          class="text-body-small max-w-text-body-small font-medium text-muted-moss text-end max-md:text-center"
          >IUCN NL (2025)</span
        >
      </div>
    </div>
  </div>
  <div class="section-highlight bg-soft-sand">
    <div
      class="max-w-6xl mx-auto py-custom-3xl flex flex-col gap-custom-xs max-md:mx-6 max-xl:mx-10">
      <h3
        class="second-highlight-text text-heading-super max-w-text-heading-super tracking-wide text-deep-pine-charcoal flex flex-col gap-custom-xs">
        <span>
          We focus on <span class="text-green">reducing plastic waste</span> that
          ends up in the ocean and landfills.
        </span>
        <span>
          by doing so, we <span class="text-green"
            >give plastic waste a second life</span
          > and turn it into something useful.
        </span>
      </h3>
    </div>
  </div>
  <div
    class="max-w-6xl mx-auto grid grid-cols-12 grid-rows-1 auto-rows-auto pb-custom-3xl gap-x-custom-2xs gap-y-custom-l items-center max-md:flex max-md:flex-col max-md:gap-custom-s max-md:mx-6 max-lg:pb-custom-2xl max-xl:mx-10">
    <div
      class="col-span-6 col-end-7 flex flex-col gap-custom-m max-md:order-2 max-md:items-center">
      {allStats.map((s) => <StatCard stat={s} />)}
    </div>
    <div
      class="col-span-6 col-end-13 px-custom-l-xl py-custom-l-xl max-md:order-1 max-md:px-custom-s-l">
      <Image
        class="object-cover object-center w-full aspect-video rounded-2xl rotate-6 shadow-tl-solid-honey"
        src={alohaPressing}
        alt="plastic glass trashes"
        layout="constrained"
        format="webp"
      />
    </div>
    <div
      class="col-span-12 row-end-3 justify-self-center mt-custom-l max-md:order-3">
      <PrimaryButton
        client:load
        transition:persist
        href={learnMoreButton.href}
        active={learnMoreButton.active}
        size={learnMoreButton.size}>
        {learnMoreButton.children}
      </PrimaryButton>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { SplitText } from "gsap/SplitText";
  import { ScrollTrigger } from "gsap/all";

  gsap.registerPlugin(SplitText, ScrollTrigger);

  function initHL() {
    const highlightContainer = document.getElementById("brand-highlight");
    if (!highlightContainer) return;
    console.log("start animate brand highlight");
    let tl = gsap.timeline({
      scrollTrigger: {
        trigger: ".about-us",
        toggleActions: "play none reverse restart",
        markers: false,
        start: "top bottom-=10%",
        end: "center top+=30%",
        scrub: 3,
      },
    });

    let otherTL = gsap.timeline({
      scrollTrigger: {
        trigger: ".section-highlight",
        toggleActions: "play none reverse restart",
        markers: false,
        start: "top bottom-=20%",
        end: "center top+=40%",
        scrub: 1,
      },
    });

    let split1 = SplitText.create(".about-us", {
      type: "words",
    });

    let split2 = SplitText.create(".highlight-text", {
      type: "words",
      wordsClass: "word",
    });

    tl.from(split1.words, {
      opacity: 0,
      stagger: 0.1,
      ease: "none",
    }).from(split2.words, {
      opacity: 0,
      stagger: 0.3,
      ease: "none",
    });

    let split3 = SplitText.create(".second-highlight-text", {
      type: "words",
      wordsClass: "word",
    });

    otherTL.from(split3.words, {
      y: 100,
      opacity: 0,
      stagger: 0.3,
      ease: "power2.in",
    });
  }

  document.removeEventListener("astro:page-load", initHL);
  document.addEventListener("astro:page-load", initHL);
</script>
