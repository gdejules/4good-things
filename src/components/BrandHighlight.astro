<script>
  import { random } from "gsap";
  import { gsap } from "gsap";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(SplitText);

  let split = SplitText.create(".highlight-text", {
    type: "chars, words, lines",
    wordsClass: "word++",
  });

  gsap.from(split.words, {
    y: 100,
    autoAlpha: 0,
    stagger: {
      from: "random",
      amount: 0.05,
      repeat: 3,
    },
  });
</script>
