---
import "../styles/global.css";
import { Image } from "astro:assets";
import alohaTrash from "/src/assets/highlight/aloha-trash-3.jpeg";
import alohaPressing from "/src/assets/collab/aloha/aloha-pressing.png";
import Button from "./Button.astro";
---

<section id="brand-highlight" class="section flex flex-col gap-custom-xl-2xl">
  <div class="bg-soft-sand">
    <div
      class="max-w-6xl mx-auto py-20 flex flex-col gap-custom-xs max-md:mx-6 max-xl:mx-10">
      <h2 class="text-heading-medium max-w-text-heading-medium text-muted-moss">
        About us
      </h2>
      <h3
        class="text-heading-large max-w-text-heading-large tracking-wide text-deep-pine-charcoal flex flex-col gap-custom-xs">
        <span><span class="text-green">4GoodThings</span> is where </span>
        <span>
          plastic waste <span class="text-green">stop being trash</span> and</span
        >
        <span>
          starts becoming <span class="text-green">something that matters</span>
        </span>
      </h3>
    </div>
  </div>
  <div
    class="max-w-6xl mx-auto grid grid-cols-12 gap-x-custom-2xs max-md:flex max-md:flex-col max-md:gap-custom-s max-md:items-center max-md:mx-6 max-xl:mx-10">
    <div
      class="order-1 col-span-6 col-end-7 px-custom-l-xl py-custom-l-xl max-md:order-2 max-md:px-custom-2xs-xl">
      <Image
        class="object-cover object-center w-full aspect-auto rounded-2xl -rotate-6 shadow-(--shadow-solid-honey)"
        src={alohaTrash}
        alt="plastic glass trashes"
        layout="constrained"
        format="webp"
      />
    </div>
    <div
      class="order-2 col-span-6 col-end-13 flex flex-col gap-custom-m max-md:order-1">
      <h3 class="text-heading-medium text-orange">
        the world is producing 430 million tonnes of plastic per year
      </h3>
      <div class="flex flex-col gap-custom-2xs font-body">
        <span
          class="text-body-large max-w-text-body-large font-bold text-deep-pine-charcoal"
          >46% of plastic waste is landfilled.</span
        >
        <span
          class="text-body-normal max-w-text-body-normal font-normal text-deep-pine-charcoal"
          >Plastic makes up the biggest, and most harmful, representing at least
          85% of total marine waste.</span
        >
        <span
          class="text-body-normal max-w-text-body-normal font-normal text-muted-moss"
          >un.org (2023)</span
        >
      </div>
      <div class="flex flex-col gap-custom-2xs font-body">
        <span
          class="text-body-large max-w-text-body-large font-bold text-deep-pine-charcoal"
          >Indonesia is world's fifth-largest contributor to plastic waste in
          the ocean.</span
        >
        <span
          class="text-body-normal max-w-text-body-normal font-normal text-deep-pine-charcoal"
          >More than 60% of the total plastic waste is mismanaged.</span
        >
        <span
          class="text-body-normal max-w-text-body-normal font-normal text-muted-moss"
          >IUCN NL (2025)</span
        >
      </div>
    </div>
  </div>
  <div class="bg-soft-sand">
    <div
      class="max-w-6xl mx-auto py-20 flex flex-col gap-custom-xs max-md:mx-6 max-xl:mx-10">
      <h3
        class="text-heading-large max-w-text-heading-large tracking-wide text-deep-pine-charcoal flex flex-col gap-custom-xs">
        <span
          >We focus on <span class="text-green">reducing plastic waste</span> that
          ends up in the ocean and landfills.</span
        >
        <span>
          by doing so, we <span class="text-green"
            >give plastic waste a second life</span
          > and turn it into something useful.
        </span>
      </h3>
    </div>
  </div>
  <div
    class="max-w-6xl mx-auto grid grid-cols-12 pb-20 gap-x-custom-2xs max-md:flex max-md:flex-col max-md:gap-custom-s max-md:items-center max-md:mx-6 max-lg:pb-custom-2xl max-lg:items-start max-xl:mx-10">
    <div
      class="order-1 col-span-6 col-end-7 px-custom-l-xl py-custom-l-xl max-lg:px-custom-l-xl">
      <Image
        class="object-cover object-center w-full aspect-video rounded-2xl rotate-6 shadow-(--shadow-solid-honey)"
        src={alohaPressing}
        alt="plastic glass trashes"
        layout="constrained"
        format="webp"
      />
    </div>
    <div
      class="w-full order-2 col-span-6 col-end-13 flex flex-col gap-custom-m max-md:items-center">
      <div class="flex flex-col gap-custom-2xs max-md:items-center">
        <h3 class="text-heading-medium text-deep-pine-charcoal">
          more than <span class="text-green">14.433 kg</span>
        </h3>
        <span
          class="font-body text-body-normal max-w-text-body-normal font-normal text-deep-pine-charcoal"
          >the total of plastic waste recycled per November 2025.</span
        >
      </div>
      <div class="flex flex-col gap-custom-2xs max-md:items-center">
        <h3 class="text-heading-medium text-deep-pine-charcoal">
          over <span class="text-green">3.946.667 pieces</span>
        </h3>
        <span
          class="font-body text-body-normal max-w-text-body-normal font-normal text-deep-pine-charcoal"
          >the total of mixed plastic bottle waste that we have been collected
          so far.</span
        >
      </div>
      <Button>
        <a href="/about">learn more</a>
      </Button>
    </div>
  </div>
</section>
