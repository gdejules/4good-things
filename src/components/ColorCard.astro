---
import type { CollectionEntry } from "astro:content";
import "../styles/global.css";

type Props = {
  color: CollectionEntry<"colors">;
};

const { color } = Astro.props;
const { name, textureImage } = color.data;
import Image from "astro/components/Image.astro";
---

<div
  class="w-full h-auto col-span-3 flex flex-col gap-custom-2xs justify-start items-start max-md:col-span-1">
  <Image
    class="object-cover object-center w-full aspect-square rounded-lg"
    src={textureImage.src}
    alt={textureImage.alt}
    layout="constrained"
    format="webp"
  />
  <h3
    class="font-body text-body-normal font-extrabold text-deep-pine-charcoal max-sm:text-body-small">
    {name}
  </h3>
</div>
