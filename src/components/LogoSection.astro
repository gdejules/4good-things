---
import LogoLoop, { type LogoItem } from "./LogoLoop";

const clientLogos: LogoItem[] = [
  { src: "/logos/ashta.png", alt: "ashta district 8 logo" },
  { src: "/logos/four-seasons.png", alt: "four seasons logo" },
  { src: "/logos/heineken.png", alt: "heineken logo" },
  { src: "/logos/ikea.png", alt: "ikea logo" },
  { src: "/logos/jungle-padel.png", alt: "jungle padel logo" },
  { src: "/logos/petronas.png", alt: "petronas logo" },
  {
    src: "/logos/prasetiya-mulya.png",
    alt: "universitas prasetiya mulya logo",
  },
  { src: "/logos/samsonite.png", alt: "samsonite logo" },
  { src: "/logos/xlsmart.png", alt: "xl smart logo" },
];
---

<section class="section pt-24 pb-32 bg-soft-sand">
  <h2
    class="font-display text-heading-medium text-deep-pine-charcoal text-center mb-custom-xl-2xl">
    Our past collaborations
  </h2>
  <div style={{ height: "120px", position: "relative", overflow: "hidden" }}>
    <LogoLoop
      logos={clientLogos}
      speed={130}
      direction="left"
      logoHeight={100}
      gap={60}
      hoverSpeed={0}
      scaleOnHover
      fadeOut
      fadeOutColor="#f4f1dc"
      ariaLabel="Clients"
      client:visible
    />
  </div>
</section>
