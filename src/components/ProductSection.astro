---
import { getCollection } from "astro:content";
import "../styles/global.css";
import ProductCard from "./ProductCard.astro";
const smallerProducts = await getCollection("products", ({ data }) => {
  return data.category === "smaller-things";
});
const largerProducts = await getCollection("products", ({ data }) => {
  return data.category === "larger-things";
});
import MenuButtonAstroComponent from "./MenuButton.astro";
---

<section class="w-full h-auto py-20 bg-forest-shadow">
  <div
    class="max-w-6xl mx-auto px-4 flex flex-col justify-start items-center gap-20 max-sm:mx-custom-xs max-sm:gap-16">
    <div class="flex-1 flex flex-col justify-stretch gap-4">
      <h2 class="font-display text-heading-small text-cream">Our products</h2>
      <span class="font-display text-heading-large md:text-6xl text-pure-white">
        We design functional and emotionally valuable products
      </span>
      <p class="font-body text-body-large text-cream">
        Explore our Smaller Things and Larger Things product categories
      </p>
    </div>
    <div class="flex flex-col gap-5">
      <h3 class="font-display text-heading-medium text-pure-white">
        Featured Smaller Things
      </h3>
      <div
        class="flex flex-col gap-8 sm:grid sm:grid-cols-2 sm:gap-4 lg:flex lg:flex-row lg:justify-between lg:gap-8">
        {smallerProducts.slice(0, 3).map((p) => <ProductCard product={p} />)}
      </div>
    </div>
    <div class="flex flex-col gap-5">
      <h3 class="font-display text-heading-medium text-pure-white">
        Featured Larger Things
      </h3>
      <div
        class="flex flex-col gap-8 sm:grid sm:grid-cols-2 sm:gap-4 lg:flex lg:flex-row lg:justify-between lg:gap-8">
        {largerProducts.slice(0, 3).map((p) => <ProductCard product={p} />)}
      </div>
    </div>
    <MenuButtonAstroComponent>
      <a href="/product/"> See All Products </a>
    </MenuButtonAstroComponent>
  </div>
</section>
