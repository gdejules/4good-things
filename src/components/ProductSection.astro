---
import "../styles/global.css";
import ProductCard from "./ProductCard.astro";
---

<div class="w-full h-auto py-12 px-24 bg-white">
  <div class="flex justify-between items-end gap-5 mb-6">
    <div class="flex-1 flex flex-col justify-stretch gap-4">
      <h2>
        We design products that functional, emotionally valuable, rooted in
        waste reduction principle
      </h2>
      <p class="text-xl">
        Explore our Smaller Things and Larger Things product categories
      </p>
    </div>
    <a
      href="/product/"
      class="flex-shrink-0 flex items-center hover:text-green hover:underline">
      <span class="font-mono text-sm uppercase">
        See Smaller Things Products <span class="font-mono text-xl">→</span>
      </span>
      <!-- <span class="font-mono text-base ml-2">→</span> -->
    </a>
  </div>
  <div class="flex flex-row justify-between items-start">
    <ProductCard />
    <ProductCard />
    <ProductCard />
    <ProductCard />
  </div>
</div>
