---
import { getCollection } from "astro:content";
import "../styles/global.css";
import ProductCard from "./ProductCard.astro";
const smallerProducts = await getCollection("products", ({ data }) => {
  return data.category === "smaller-things";
});
const largerProducts = await getCollection("products", ({ data }) => {
  return data.category === "larger-things";
});
---

<div class="w-full h-auto py-20 px-24 bg-forest-shadow">
  <div class="flex flex-col justify-start gap-20">
    <div class="flex-1 flex flex-col justify-stretch gap-4 w-3/4">
      <span class="font-display text-lg md:text-2xl text-cream"
        >Our products</span
      >
      <h2 class="font-display text-2xl md:text-6xl text-pure-white">
        We design products that functional, emotionally valuable, rooted in
        waste reduction principle
      </h2>
      <p class="font-body text-lg md:text-2xl text-pure-white">
        Explore our Smaller Things and Larger Things product categories
      </p>
    </div>
    <div class="flex flex-col gap-5">
      <div class="flex justify-between">
        <h3
          class="flex-1 font-display text-xl md:text-3xl uppercase text-pure-white">
          Featured Smaller Things Products
        </h3>
        <a
          href="/product/"
          class="shrink-0 flex items-center hover:text-green hover:underline">
          <span class="font-body text-base uppercase text-pure-white">
            See All Smaller Things <span class="font-body text-xl">→</span>
          </span>
        </a>
      </div>
      <div class="flex justify-between items-start">
        {smallerProducts.slice(0, 3).map((p) => <ProductCard product={p} />)}
      </div>
    </div>
    <div class="flex flex-col gap-5">
      <div class="flex justify-between">
        <h3
          class="flex-1 font-display text-xl md:text-3xl uppercase text-pure-white">
          Featured Larger Things Products
        </h3>
        <a
          href="/product/"
          class="shrink-0 flex items-center hover:text-green hover:underline">
          <span class="font-body text-base uppercase text-pure-white">
            See All Larger Things <span class="font-body text-xl">→</span>
          </span>
        </a>
      </div>
      <div class="flex justify-between items-start">
        {largerProducts.slice(0, 3).map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </div>
</div>
