---
import "../styles/global.css";
import ProductCard from "./ProductCard.astro";
---

<div class="w-full h-auto py-12 px-24 bg-white">
  <div class="flex flex-col justify-start gap-10">
    <div class="flex-1 flex flex-col justify-stretch gap-4 w-3/4">
      <h2>
        We design products that functional, emotionally valuable, rooted in
        waste reduction principle
      </h2>
      <p class="text-xl">
        Explore our Smaller Things and Larger Things product categories
      </p>
    </div>
    <div class="flex flex-col gap-5">
      <div class="flex justify-between">
        <h3 class="flex-1">Featured Smaller Things Products</h3>
        <a
          href="/product/"
          class="flex-shrink-0 flex items-center hover:text-green hover:underline">
          <span class="font-mono text-sm uppercase">
            See All Smaller Things <span class="font-mono text-xl">→</span>
          </span>
        </a>
      </div>
      <div class="flex justify-between items-start">
        <ProductCard
          imagePath="/src/assets/products/hanger.jpeg"
          altText="Red and blue hanger products hanging on the steel bar"
          name="Hanging Hanger"
          wasteRecycled={1}
        />
        <ProductCard
          imagePath="/src/assets/products/phone-holder.jpeg"
          altText="A smartphone lean on a blue phone holder"
          name="Phone Holder"
          wasteRecycled={0.3}
        />
        <ProductCard
          imagePath="/src/assets/products/sign-board.jpeg"
          altText="A blue sign board in front of a cafe"
          name="Signage Board"
          wasteRecycled={3}
        />
        <ProductCard
          imagePath="/src/assets/products/trash-bin.jpeg"
          altText="Blue and green trash bin"
          name="Trash Bin"
          wasteRecycled={4}
        />
      </div>
    </div>
    <div class="flex flex-col gap-5">
      <div class="flex justify-between">
        <h3 class="flex-1">Featured Larger Things Products</h3>
        <a
          href="/product/"
          class="flex-shrink-0 flex items-center hover:text-green hover:underline">
          <span class="font-mono text-sm uppercase">
            See All Larger Things <span class="font-mono text-xl">→</span>
          </span>
        </a>
      </div>
      <div class="flex justify-between items-start">
        <ProductCard
          imagePath="/src/assets/products/hanger.jpeg"
          altText="Red and blue hanger products hanging on the steel bar"
          name="Hanging Hanger"
          wasteRecycled={1}
        />
        <ProductCard
          imagePath="/src/assets/products/phone-holder.jpeg"
          altText="A smartphone lean on a blue phone holder"
          name="Phone Holder"
          wasteRecycled={0.3}
        />
        <ProductCard
          imagePath="/src/assets/products/sign-board.jpeg"
          altText="A blue sign board in front of a cafe"
          name="Signage Board"
          wasteRecycled={3}
        />
        <ProductCard
          imagePath="/src/assets/products/trash-bin.jpeg"
          altText="Blue and green trash bin"
          name="Trash Bin"
          wasteRecycled={4}
        />
      </div>
    </div>
  </div>
</div>
