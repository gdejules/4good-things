---
import { getCollection } from "astro:content";
import "../styles/global.css";
import ProductCard from "./ProductCard.astro";
const smallerProducts = await getCollection("products", ({ data }) => {
  return data.category === "smaller-things" && data.featured === true;
});
const largerProducts = await getCollection("products", ({ data }) => {
  return data.category === "larger-things" && data.featured === true;
});
import { PrimaryButton } from "./CustomAwesomeButton";

const seeMoreProductButton = {
  children: "See more",
  href: "/product",
  className: "product-content",
  size: "large",
  active: false,
};
---

<section class="section py-24 bg-forest-shadow">
  <div
    class="max-w-6xl mx-auto flex flex-col justify-start items-center gap-custom-xl-2xl max-md:mx-6 max-xl:mx-10">
    <div class="flex-1 flex flex-col justify-start gap-custom-xs">
      <h2 class="font-body font-medium text-body-large uppercase text-cream">
        Our products
      </h2>
      <span
        class="font-display text-heading-large max-w-text-heading-large text-pure-white">
        We design functional and emotionally valuable products
      </span>
      <p class="font-body text-body-normal max-w-text-body-normal text-cream">
        Our product line up are made with functional design and purpose to bring
        joy in your everyday needs. Explore our Smaller Things and Larger Things
        product categories based on its dimensions.
      </p>
    </div>
    <div class="flex flex-col gap-custom-m-l">
      <h3 class="text-heading-small max-w-text-heading-small text-pure-white">
        Featured Smaller Things
      </h3>
      <div
        class="grid grid-cols-12 auto-rows-auto gap-x-custom-2xs gap-y-custom-xl max-md:grid-cols-2 max-md:gap-y-custom-m-l">
        {smallerProducts.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
    <div class="flex flex-col gap-custom-m-l">
      <h3 class="text-heading-small max-w-text-heading-small text-pure-white">
        Featured Larger Things
      </h3>
      <div
        class="grid grid-cols-12 auto-rows-auto gap-x-custom-2xs gap-y-custom-xl max-md:grid-cols-2 max-md:gap-y-custom-m-l">
        {largerProducts.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
    <PrimaryButton
      client:load
      transition:persist
      href={seeMoreProductButton.href}
      active={seeMoreProductButton.active}
      size={seeMoreProductButton.size}>
      {seeMoreProductButton.children}
    </PrimaryButton>
  </div>
</section>
