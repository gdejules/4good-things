---
import "../styles/global.css";
import Button from "./Button.astro";
import { Image } from "astro:assets";
import alohaTable from "/src/assets/hero/aloha-table.jpeg";
import asthaTable from "/src/assets/hero/astha-table.jpeg";
import padelKeychain from "/src/assets/hero/padel-keychain.jpeg";
import signatureStool from "/src/assets/hero/signature-stool.jpeg";
---

<section class="section py-custom-xl-2xl bg-warm-alabaster">
  <div class="wrapper">
    <div
      class="order-1 max-md:order-2 col-span-6 col-end-7 flex flex-col justify-center items-start gap-5">
      <h1 class="flex flex-col text-deep-pine-charcoal">
        <span><span class="text-green">Good Things</span> are</span>
        <span>Coming to You</span>
      </h1>
      <p class="body-large text-muted-moss">
        We are reducing plastic waste that ends up in the ocean and landfills by
        giving it a second life and turn it into something impactful.
      </p>
      <Button>
        <a href="#brand-highlight"> about us </a>
      </Button>
    </div>
    <div
      class="order-2 max-md:order-1 col-span-6 col-end-13 grid grid-cols-6 grid-rows-2 gap-x-custom-xs-s gap-y-custom-xs-s max-md:grid-cols-2">
      <div
        class="col-start-1 col-end-4 row-start-1 row-end-2 flex items-center max-md:col-start-1 max-md:col-end-2">
        <Image
          class="h-auto rounded-lg shadow-md"
          src={alohaTable}
          priority
          alt="A light-colored table made from recycled plastic sheet"
        />
      </div>
      <div
        class="col-start-4 col-end-7 row-start-1 row-end-2 flex justify-center items-center max-md:col-start-2 max-md:col-end-3">
        <Image
          class="w-3/4 h-auto rounded-lg shadow-md"
          src={asthaTable}
          priority
          alt="A blue-colored table made from recycled plastic sheet"
        />
      </div>
      <div
        class="col-start-4 col-end-7 row-start-2 row-end-3 flex justify-center items-center max-md:col-start-2 max-md:col-end-3">
        <Image
          class="w-2/3 h-auto rounded-lg shadow-md"
          src={padelKeychain}
          priority
          alt="Five small padel racket keychain made from recycled plastic sheet"
        />
      </div>
      <div
        class="col-start-1 col-end-4 row-start-2 row-end-3 flex justify-center items-center max-md:col-start-1 max-md:col-end-2">
        <Image
          class="w-3/4 rounded-lg shadow-md"
          src={signatureStool}
          priority
          alt="A red stool made from recycled plastic sheet"
        />
      </div>
    </div>
  </div>
</section>
