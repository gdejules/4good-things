---
import "../styles/global.css";
import { Image } from "astro:assets";
import alohaTable from "/src/assets/hero/aloha-table.jpeg";
import asthaTable from "/src/assets/hero/astha-table.jpeg";
import padelKeychain from "/src/assets/hero/padel-keychain.jpeg";
import signatureStool from "/src/assets/hero/signature-stool.jpeg";
import tableStool from "/src/assets/hero/table-and-stool.jpeg";
---

<div class="w-full px-24 pt-5 pb-14 min-h-screen bg-lightBackground">
  <div class="flex justify-between items-center gap-9">
    <div class="text-dark w-1/2 flex flex-col justify-center items-start gap-5">
      <h1>Good Things are Coming to You</h1>
      <span class="text-xl text-dark">
        What if waste——especially plastic——was not the end of a story, but the
        beginning of something new?
      </span>
      <a
        href="#about"
        class="flex-shrink-0 flex items-center mt-3 text-orange hover:text-dark">
        <span class="text-lg uppercase">
          Explore More <span class="text-xl">↓</span>
        </span>
      </a>
    </div>
    <div class="w-1/2 h-screen relative">
      <Image
        class="absolute top-16 left-20 w-64 h-auto rounded-lg shadow-md"
        src={alohaTable}
        priority
        alt="A light-colored table made from recycled plastic sheet"
      />
      <Image
        class="absolute top-4 right-8 w-48 h-auto rounded-lg shadow-md"
        src={asthaTable}
        priority
        alt="A blue-colored table made from recycled plastic sheet"
      />
      <Image
        class="absolute top-80 right-56 w-32 h-auto rounded-lg shadow-md"
        src={padelKeychain}
        priority
        alt="Five small padel racket keychain made from recycled plastic sheet"
      />
      <Image
        class="absolute top-72 left-1 w-48 h-auto rounded-lg shadow-md"
        src={signatureStool}
        priority
        alt="A red stool made from recycled plastic sheet"
      />
      <Image
        class="absolute top-96 right-2 w-48 h-auto rounded-lg shadow-md"
        src={tableStool}
        priority
        alt="A table and two stool with green color made from recycled plastic sheet"
      />
    </div>
  </div>
</div>
<div id="about" class="w-full h-auto px-24 py-16 bg-green/[0.2]">
  <div class="container mx-auto flex flex-row justify-between gap-10">
    <div class="w-1/3 flex flex-col justify-between gap-12">
      <div class="flex flex-col gap-5">
        <span class="highlight text-orange block">5th in the world</span>
        <p class="text-xl">
          Indonesia is world's fifth-largest contributor to plastic waste in the
          ocean.
        </p>
      </div>
      <div class="flex flex-col gap-5">
        <span class="highlight text-orange block">60% is mismanaged</span>
        <p class="text-xl">
          More than 60% of the total plastic waste is mismanaged.
        </p>
      </div>
    </div>
    <div class="w-1/3 flex flex-col justify-center gap-4">
      <span class="highlight text-black block">
        4GoodThings is where plastic waste stops being trash and starts becoming
        something that matters.
      </span>
      <a
        href="/about"
        class="flex-shrink-0 flex items-center text-black hover:text-orange hover:underline">
        <span class="font-mono text-sm uppercase">
          About Us <span class="font-mono text-xl">→</span>
        </span>
      </a>
    </div>
    <div class="w-1/3 flex flex-col justify-between gap-12">
      <div class="flex flex-col gap-5">
        <span class="highlight text-orange">14.433 kg</span>
        <p class="text-xl">plastic waste recycled per November 2025</p>
      </div>
      <div class="flex flex-col gap-5">
        <span class="highlight text-orange">3.946.667 pieces</span>
        <p class="text-xl">of mixed plastic bottle waste has been collected</p>
      </div>
    </div>
  </div>
</div>
