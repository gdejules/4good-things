---
import "../styles/global.css";
import { Image } from "astro:assets";
import alohaTable from "/src/assets/hero/aloha-table.jpeg";
import asthaTable from "/src/assets/hero/astha-table.jpeg";
import padelKeychain from "/src/assets/hero/padel-keychain.jpeg";
import signatureStool from "/src/assets/hero/signature-stool.jpeg";
import { PrimaryButton, DownloadButton } from "./CustomAwesomeButton.tsx";

const learnMoreButton = {
  children: "Learn more",
  href: "/about",
  className: "about-content",
  size: "large",
  active: false,
};
const downloadButton = {
  children: "Catalogue",
  href: "/downloads/REV-1 Catalogue 4GoodThings.pdf",
  download: "Product Catalogue",
  className: "download",
  size: "large",
  active: false,
};
---

<section id="hero" class="section py-custom-xl-2xl bg-warm-alabaster">
  <div class="wrapper">
    <div
      class="order-1 max-md:order-2 col-span-6 col-end-7 flex flex-col justify-center items-start gap-5 max-md:items-center">
      <h1 class="flex flex-col text-deep-pine-charcoal max-md:text-center">
        <span><span class="text-green">Good Things</span> are</span>
        <span>Coming to You</span>
      </h1>
      <p class="body-large text-muted-moss max-md:text-center">
        We are reducing plastic waste that ends up in the ocean and landfills by
        giving it a second life and turn it into something impactful.
      </p>
      <ul
        class="main-cta flex gap-custom-s max-md:flex-col max-md:gap-custom-m max-md:items-center">
        <li class="max-lg:hidden">
          <PrimaryButton
            client:load
            transition:persist
            href={learnMoreButton.href}
            active={learnMoreButton.active}
            size={learnMoreButton.size}>
            {learnMoreButton.children}
          </PrimaryButton>
        </li>
        <li class="lg:hidden">
          <PrimaryButton
            client:load
            transition:persist
            href={learnMoreButton.href}
            active={learnMoreButton.active}
            size="medium">
            {learnMoreButton.children}
          </PrimaryButton>
        </li>
        <li class="max-lg:hidden">
          <DownloadButton
            client:load
            transition:persist
            href={downloadButton.href}
            active={downloadButton.active}
            size={downloadButton.size}>
            {downloadButton.children}
          </DownloadButton>
        </li>
        <li class="lg:hidden">
          <DownloadButton
            client:load
            transition:persist
            href={downloadButton.href}
            active={downloadButton.active}
            size="medium">
            {downloadButton.children}
          </DownloadButton>
        </li>
      </ul>
    </div>
    <div
      class="order-2 max-md:order-1 col-span-6 col-end-13 grid grid-cols-6 grid-rows-2 gap-x-custom-xs-s gap-y-custom-xs-s max-md:grid-cols-2">
      <div
        class="col-start-1 col-end-4 row-start-1 row-end-2 flex items-center max-md:col-start-1 max-md:col-end-2">
        <Image
          class="thing thing-1 h-auto rounded-lg shadow-md"
          src={alohaTable}
          priority
          alt="A light-colored table made from recycled plastic sheet"
        />
      </div>
      <div
        class="col-start-4 col-end-7 row-start-1 row-end-2 flex justify-center items-center max-md:col-start-2 max-md:col-end-3">
        <Image
          class="thing thing-2 w-3/4 h-auto rounded-lg shadow-md"
          src={asthaTable}
          priority
          alt="A blue-colored table made from recycled plastic sheet"
        />
      </div>
      <div
        class="col-start-4 col-end-7 row-start-2 row-end-3 flex justify-center items-center max-md:col-start-2 max-md:col-end-3">
        <Image
          class="thing thing-3 w-2/3 h-auto rounded-lg shadow-md"
          src={padelKeychain}
          priority
          alt="Five small padel racket keychain made from recycled plastic sheet"
        />
      </div>
      <div
        class="col-start-1 col-end-4 row-start-2 row-end-3 flex justify-center items-center max-md:col-start-1 max-md:col-end-2">
        <Image
          class="thing thing-4 w-3/4 rounded-lg shadow-md"
          src={signatureStool}
          priority
          alt="A red stool made from recycled plastic sheet"
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap/gsap-core";

  // Use setTimeout to ensure DOM is fully rendered
  function initHero() {
    const heroContainer = document.getElementById("hero");
    if (!heroContainer) return;

    console.log("start animate hero images");
    const thing1 = document.querySelector(".thing-1");
    const thing2 = document.querySelector(".thing-2");
    const thing3 = document.querySelector(".thing-3");
    const thing4 = document.querySelector(".thing-4");

    if (thing1) {
      gsap.to(".thing-1", {
        keyframes: {
          y: [0, -8, 0],
          rotation: [0, -1, 0.5, 0],
          ease: "none",
          easeEach: "sine.inOut",
        },
        duration: 1.2,
        repeat: -1,
        transformOrigin: "center center",
      });
    }

    if (thing2) {
      gsap.to(".thing-2", {
        keyframes: {
          y: [0, -8, 0],
          rotation: [0, 1, -0.5, 0],
          ease: "none",
          easeEach: "sine.inOut",
        },
        duration: 1.2,
        delay: 0.15,
        repeat: -1,
        transformOrigin: "center center",
      });
    }

    if (thing3) {
      gsap.to(".thing-3", {
        keyframes: {
          y: [0, -8, 0],
          rotation: [0, -2, 0.5, 0],
          ease: "none",
          easeEach: "sine.inOut",
        },
        duration: 1.2,
        delay: 0.3,
        repeat: -1,
        transformOrigin: "center center",
      });
    }

    if (thing4) {
      gsap.to(".thing-4", {
        keyframes: {
          y: [0, -8, 0],
          rotation: [0, 1.5, -1, 0],
          ease: "none",
          easeEach: "sine.inOut",
        },
        duration: 1.2,
        delay: 0.45,
        repeat: -1,
        transformOrigin: "center center",
      });
    }
  }

  document.removeEventListener("astro:page-load", initHero); // astro:page-load
  document.addEventListener("astro:page-load", initHero); // astro:page-load
</script>
