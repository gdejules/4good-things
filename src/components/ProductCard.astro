---
import type { CollectionEntry } from "astro:content";
import "../styles/global.css";

type Props = {
  product: CollectionEntry<"products">;
};

const { product } = Astro.props;
const { name, recycledWeight, price, images } = product.data;
import { formatPrice } from "../data/product.ts";
import Image from "astro/components/Image.astro";
---

<div
  class="w-full h-auto flex flex-col justify-start items-start py-3 px-3 bg-soft-sand rounded-2xl">
  <Image
    class="object-cover object-center w-full aspect-square rounded-lg"
    src={images[0].src}
    alt={images[0].alt}
    layout="constrained"
    format="webp"
  />
  <h4 class="my-3 font-display text-heading-small text-deep-pine-charcoal">
    {name}
  </h4>
  <p class="font-body text-body-small text-muted-moss">
    {recycledWeight} of plastic waste recycled
  </p>
  <p class="font-body text-body-small font-medium text-green">
    {formatPrice(price)}
  </p>
</div>
