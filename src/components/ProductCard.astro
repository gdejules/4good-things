---
import type { CollectionEntry } from "astro:content";
import "../styles/global.css";

type Props = {
  product: CollectionEntry<"products">;
};

const { product } = Astro.props;
const { name, recycledWeight, price, images } = product.data;
import { formatPrice } from "../data/product.ts";
import Image from "astro/components/Image.astro";
---

<div
  class="w-full h-auto col-span-3 flex flex-col gap-custom-2xs justify-start items-start py-custom-2xs px-custom-2xs bg-warm-alabaster rounded-2xl max-md:col-span-1">
  <Image
    class="object-cover object-center w-full aspect-square rounded-lg"
    src={images[0].src}
    alt={images[0].alt}
    layout="constrained"
    format="webp"
  />
  <h4
    class="my-custom-2xs-xs font-body text-body-normal font-extrabold text-deep-pine-charcoal">
    {name}
  </h4>
  <p class="font-body text-body-small text-muted-moss">
    {recycledWeight} of plastic waste recycled
  </p>
  <p class="font-body text-body-normal font-medium text-blue">
    {formatPrice(price)}
  </p>
</div>
