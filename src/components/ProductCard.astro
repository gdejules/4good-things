---
import type { CollectionEntry } from "astro:content";
import "../styles/global.css";

type Props = {
  product: CollectionEntry<"products">;
};

const { product } = Astro.props;
const { name, category, recycledWeight, price, images } = product.data;
import { formatPrice } from "../data/product.ts";
import Image from "astro/components/Image.astro";
---

<div
  class="relative min-w-0 h-auto col-span-3 flex flex-col gap-custom-2xs justify-start items-start bg-warm-alabaster rounded-2xl max-md:col-span-1 overflow-clip border-[lightgrey] border-2">
  <p
    class="absolute top-2 left-2 right-2 amount max-w-max truncate font-body text-body-small font-normal text-green backdrop-blur-lg py-custom-3xs px-custom-s rounded-full hover:text-pure-white hover:bg-green">
    {recycledWeight} of plastic waste recycled
  </p>
  <Image
    class="object-cover object-center w-full aspect-square mb-custom-2xs"
    src={images[0].src}
    alt={images[0].alt}
    layout="constrained"
    format="webp"
  />
  <p
    class="category font-body text-body-small font-normal text-muted-moss uppercase tracking-wider px-custom-xs overflow-hidden">
    {category}
  </p>
  <h3
    class="name truncate w-full font-body text-body-large font-bold text-deep-pine-charcoal max-sm:text-body-normal px-custom-xs overflow-hidden mb-custom-xs-s">
    {name}
  </h3>
  <p
    class="price font-body text-body-normal font-medium text-blue max-sm:text-body-small hover:text-pure-white hover:bg-blue self-end rounded-tl-2xl py-custom-3xs px-custom-s overflow-hidden text-ellipsis">
    {formatPrice(price)}
  </p>
</div>
