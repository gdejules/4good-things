---
// import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  imagePath: string;
  altText: string;
  name: string;
  wasteRecycled: number;
}

const { imagePath, altText, name, wasteRecycled } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/products/*.{jpeg,jpg,png,gif}",
);
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/products/*.{jpeg,jpg,png,gif}"`,
  );
---

<div class="card w-72 flex flex-col justify-start items-start">
  <Image
    class="object-cover object-center w-72 h-72 rounded-lg"
    src={images[imagePath]()}
    alt={altText}
    width="288"
  />
  <h2>{name}</h2>
  <p>{wasteRecycled} kg of plastic waste recycled</p>
</div>

