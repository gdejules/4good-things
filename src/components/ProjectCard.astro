---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
type Props = {
  project: CollectionEntry<"projects">;
};
const { project } = Astro.props;
const source = "data" in project ? project.data : project;
const slug =
  "slug" in project ? project.slug : project.id.replace(/\.(md|mdx)$/, "");

const { client, type, recycledWeight, description, images = [] } = source;
const primaryImage = images[0];
---

<div
  class="col-span-12 grid grid-cols-12 gap-x-custom-2xs max-md:flex max-md:flex-col max-md:gap-custom-s max-md:items-center">
  <div class="col-span-6 col-end-7 flex flex-col gap-custom-xs-s">
    <span
      class="font-body font-medium text-body-small uppercase text-muted-moss"
      >{type}</span
    >
    <h4
      class="font-display font-extrabold text-heading-medium tracking-wide text-deep-pine-charcoal">
      <span class="text-green">4GoodThings</span> with {client}
    </h4>
    <p
      class="font-body font-extrabold text-body-small max-w-max rounded-2xl text-pure-white px-custom-xs py-custom-2xs bg-green">
      {recycledWeight} of plastic waste recycled
    </p>
    <p class="font-body font-normal text-body-normal text-muted-moss">
      {description}
    </p>
    <a
      href={`/projects/${slug}`}
      class="font-body text-body-normal uppercase text-blue">Read More</a
    >
  </div>
  <div
    class="col-span-6 col-end-13 px-custom-m-l py-custom-l-xl max-md:px-custom-2xs-xl">
    <Image
      class="object-cover object-center w-full aspect-auto rounded-2xl rotate-6 shadow-tl-solid-honey"
      src={primaryImage.src}
      alt={primaryImage.alt}
      format="webp"
    />
  </div>
</div>
