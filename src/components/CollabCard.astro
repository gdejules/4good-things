---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
type Props = {
  project: CollectionEntry<"projects">;
};
const { project } = Astro.props;
const { title, recycledWeight, description, images } = project.data;
---

<div class="flex justify-between">
  <div class="flex-1 flex flex-col gap-3">
    <h2 class="my-3 font-display text-2xl md:text-4xl text-green">
      {title}
    </h2>
    <p
      class="font-body font-extrabold max-w-max rounded-2xl text-deep-pine-charcoal px-4 py-2 bg-soft-sand">
      {recycledWeight} of plastic waste recycled
    </p>
    <p class="font-body text-muted-moss">{description}</p>
  </div>
  <div class="flex-1 max-w-[460] pr-6 md:pr-10">
    <Image
      src={images[0].src}
      alt={images[0].alt}
      width="400"
      height="360"
      format="webp"
      class="w-full h-auto rounded-2xl rotate-6 md:rotate-10 shadow-(--shadow-solid)"
    />
  </div>
</div>
