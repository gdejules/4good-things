---
import "../../styles/global.css";
import { render } from "astro:content";
import { Image } from "astro:assets";
import { getProjects, type Project } from "../../data/project.ts";
import PostLayout from "../../layouts/PostLayout.astro";

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = {
  project: Project;
};

const { project } = Astro.props;

// Pass the preserved entry object to render()
const { Content } = await render(project.entry);
---

<PostLayout project={project}>
  <span class="font-body text-body-normal text-muted-moss"
    >{`${project.type} · ${project.client}`}</span
  >
  <h1 class="text-heading-large">{project.title}</h1>
  <div class="py-custom-l flex flex-col gap-custom-m">
    <div class="flex gap-custom-l max-sm:justify-between">
      <div class="flex-1 flex flex-col gap-custom-3xs">
        <span
          class="font-body text-body-small uppercase text-muted-moss tracking-wider"
          >Impact</span
        >
        <div
          class="font-body text-body-normal font-bold text-green tracking-wide">
          {`${project.recycledWeight} of plastic recycled`}
        </div>
      </div>
      <div class="flex-1 flex flex-col gap-custom-3xs">
        <span
          class="font-body text-body-small uppercase text-muted-moss tracking-wider"
          >Material</span
        >
        <div
          class="font-body text-body-normal font-bold text-muted-moss tracking-wide">
          {`${project.materialSource}`}
        </div>
      </div>
    </div>
    <div
      class="px-custom-m py-custom-xs bg-soft-sand rounded-lg font-body text-body-normal text-deep-pine-charcoal">
      {project.description}
    </div>
  </div>
  <Content />
</PostLayout>
