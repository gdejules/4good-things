---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import Button from "../components/Button.astro";
import {
  PrimaryButton,
  DownloadButton,
} from "../components/CustomAwesomeButton";

import signatureStool from "./../assets/signature-stool-1.jpeg";
import padelKeyChain from "./../assets/padel-keychain-1.jpeg";
import table from "./../assets/table-1.jpeg";
import justStool from "./../assets/just-stool.jpeg";

import { getCollection } from "astro:content";
import ProductCard from "../components/ProductCard.astro";
const allProducts = await getCollection("products");
import ColorCard from "../components/ColorCard.astro";
const allColors = await getCollection("colors");

const marketplaceButton = {
  children: "See marketplace",
  href: "https://shopee.co.id/",
  className: "product-detail",
  size: "large",
  active: false,
};
const downloadButton = {
  children: "Catalogue",
  href: "/downloads/REV-1 Catalogue 4GoodThings.pdf",
  download: "Product Catalogue",
  className: "download",
  size: "large",
  active: false,
};
---

<BaseLayout>
  <section id="product-header" class="section bg-warm-alabaster">
    <div class="wrapper pt-custom-xl pb-custom-2xl">
      <div
        class="col-span-6 col-end-7 flex flex-col justify-center items-start gap-custom-s">
        <h1
          class="text-heading-large max-w-text-heading-large text-deep-pine-charcoal">
          Good Things
        </h1>
        <p class="max-w-text-body-normal text-muted-moss">
          Our products are produced and designed efficiently, with less waste,
          and easy to assemble, guided by principle that it should be useful and
          meaningful.
        </p>
      </div>
      <div
        class="col-span-6 col-end-13 flex justify-center items-center px-custom-2xs-xl">
        <div class="flex-1">
          <Image
            class="w-auto h-1/3 aspect-auto rotate-15 rounded-lg shadow-tl-solid-green"
            src={table}
            priority
            alt="A red stool made from recycled plastic sheet"
          />
        </div>
        <div class="flex-1 z-1 -mx-custom-3xs">
          <Image
            class="w-auto h-3/4 aspect-auto rounded-lg shadow-tl-solid-green"
            src={signatureStool}
            priority
            alt="A red stool made from recycled plastic sheet"
          />
        </div>
        <div class="flex-1">
          <Image
            class="w-auto h-1/3 aspect-auto -rotate-15 rounded-lg shadow-tl-solid-green"
            src={padelKeyChain}
            priority
            alt="A red stool made from recycled plastic sheet"
          />
        </div>
      </div>
    </div>
  </section>
  <section id="product-list" class="section bg-soft-sand">
    <div
      class="max-w-6xl mx-auto py-custom-l-xl flex flex-col gap-custom-l-xl max-md:mx-6 max-xl:mx-10">
      <h2
        class="text-heading-medium max-w-text-heading-medium text-deep-pine-charcoal">
        Product Collections
      </h2>
      <div
        class="grid grid-cols-12 auto-rows-auto gap-x-custom-s gap-y-custom-xl max-md:grid-cols-2 max-md:gap-y-custom-m-l">
        {allProducts.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>
  <section id="marketplace-banner" class="section bg-soft-sand py-custom-2xl">
    <div
      class="max-w-6xl mx-auto flex items-center rounded-2xl bg-cream overflow-clip max-lg:flex-col max-lg:gap-custom-m max-md:mx-6 max-xl:mx-10">
      <div class="shrink-0">
        <Image
          class="h-120 w-auto max-sm:w-full max-sm:h-full max-sm:bg-cover"
          src={justStool}
          alt="signature stool with white and blue color"
        />
      </div>
      <div
        class="flex-1 py-custom-l-xl px-custom-2xl-3xl flex flex-col gap-custom-m max-md:items-center">
        <h2
          class="text-heading-medium max-w-text-heading-medium text-green max-lg:text-center">
          Interested to see our full product lineup?
        </h2>
        <span
          class="font-body text-body-large font-normal text-deep-pine-charcoal max-lg:text-center"
          >Go to our marketplace or download our catalogue for full product
          lineup</span
        >
        <div class="flex gap-custom-s max-md:flex-col">
          <PrimaryButton
            client:load
            href={marketplaceButton.href}
            active={marketplaceButton.active}
            size={marketplaceButton.size}>
            {marketplaceButton.children}
          </PrimaryButton>
          <DownloadButton
            client:load
            href={downloadButton.href}
            active={downloadButton.active}
            size={downloadButton.size}>
            {downloadButton.children}
          </DownloadButton>
        </div>
      </div>
    </div>
  </section>
  <section id="product-colors" class="section bg-warm-alabaster">
    <div class="wrapper grid-rows-1 auto-rows-auto py-custom-xl">
      <div class="col-span-12 row-end-2 flex flex-col gap-custom-xs-s">
        <h2
          class="text-heading-medium max-w-text-heading-medium text-deep-pine-charcoal">
          Good Sheets Colors
        </h2>
        <p class="max-w-text-body-normal text-muted-moss">
          Good Sheet is how we called our recycled plastic sheets. Available in
          various colors. Browse the options below to find your favorite ones!
        </p>
      </div>
      <div
        class="col-span-12 row-end-3 grid grid-cols-12 auto-rows-auto gap-x-custom-s gap-y-custom-xl max-md:grid-cols-2 max-md:gap-y-custom-m-l">
        {allColors.map((c) => <ColorCard color={c} />)}
      </div>
    </div>
  </section>
</BaseLayout>
