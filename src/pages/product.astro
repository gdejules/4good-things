---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import Button from "../components/Button.astro";

import signatureStool from "./../assets/signature-stool-1.jpeg";
import padelKeyChain from "./../assets/padel-keychain-1.jpeg";
import table from "./../assets/table-1.jpeg";

import { getCollection } from "astro:content";
import ProductCard from "../components/ProductCard.astro";
const allProducts = await getCollection("products");
import ColorCard from "../components/ColorCard.astro";
const allColors = await getCollection("colors");
---

<BaseLayout>
  <section id="product-header" class="section bg-warm-alabaster">
    <div class="wrapper pt-custom-xl pb-custom-2xl">
      <div
        class="col-span-6 col-end-7 flex flex-col justify-center items-start gap-custom-s">
        <h1
          class="text-heading-large max-w-text-heading-large text-deep-pine-charcoal">
          Good Things
        </h1>
        <p class="max-w-text-body-normal text-muted-moss">
          Our products are produced and designed efficiently, with less waste,
          and easy to assemble, guided by principle that it should be useful and
          meaningful.
        </p>
      </div>
      <div
        class="col-span-6 col-end-13 flex justify-center items-center px-custom-2xs-xl">
        <div class="flex-1">
          <Image
            class="w-auto h-1/3 aspect-auto rotate-15 rounded-lg shadow-solid-green"
            src={table}
            priority
            alt="A red stool made from recycled plastic sheet"
          />
        </div>
        <div class="flex-1 z-1 -mx-custom-3xs">
          <Image
            class="w-auto h-3/4 aspect-auto rounded-lg shadow-solid-green"
            src={signatureStool}
            priority
            alt="A red stool made from recycled plastic sheet"
          />
        </div>
        <div class="flex-1">
          <Image
            class="w-auto h-1/3 aspect-auto -rotate-15 rounded-lg shadow-solid-green"
            src={padelKeyChain}
            priority
            alt="A red stool made from recycled plastic sheet"
          />
        </div>
      </div>
    </div>
  </section>
  <section id="product-list" class="section bg-soft-sand">
    <div
      class="max-w-6xl mx-auto py-custom-l-xl flex flex-col gap-custom-l-xl max-md:mx-6 max-xl:mx-10">
      <div
        class="flex justify-between items-center max-md:flex-col max-md:gap-custom-s max-md:items-start">
        <h2
          class="text-heading-medium max-w-text-heading-medium text-deep-pine-charcoal">
          Product Collections
        </h2>
        <div class="flex items-center">
          <div
            class="px-custom-s-m py-custom-3xs-2xs bg-green rounded-l-full border border-green font-body text-body-small font-extrabold text-pure-white">
            all products
          </div>
          <div
            class="px-custom-s-m py-custom-3xs-2xs bg-soft-sand border border-green font-body text-body-small text-deep-pine-charcoal">
            smaller things
          </div>
          <div
            class="px-custom-s-m py-custom-3xs-2xs bg-soft-sand rounded-r-full border border-green font-body text-body-small text-deep-pine-charcoal">
            larger things
          </div>
        </div>
      </div>
      <div
        class="grid grid-cols-12 auto-rows-auto gap-x-custom-2xs gap-y-custom-xl max-md:grid-cols-2 max-md:gap-y-custom-m-l">
        {allProducts.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>
  <section id="cta-banner" class="section bg-blue">
    <div
      class="max-w-6xl mx-auto py-custom-xl-m flex justify-between items-center gap-custom-2xl max-lg:flex-col max-lg:gap-custom-m max-md:mx-6 max-xl:mx-10">
      <span
        class="font-body text-body-large font-normal text-pure-white max-lg:text-center"
        >Go to our marketplace to purchase our product or download our full
        catalogue for additional information</span
      >
      <div
        class="flex gap-custom-s max-md:flex-col max-md:items-center max-md:gap-custom-m-l">
        <Button>
          <a href=""> browse marketplace </a>
        </Button>
        <Button>
          <a href=""> download catalogue </a>
        </Button>
      </div>
    </div>
  </section>
  <section id="product-colors" class="section bg-warm-alabaster">
    <div class="wrapper grid-rows-1 auto-rows-auto py-custom-xl">
      <div class="col-span-12 row-end-2 flex flex-col gap-custom-xs-s">
        <h2
          class="text-heading-medium max-w-text-heading-medium text-deep-pine-charcoal">
          Good Sheets Colors
        </h2>
        <p class="max-w-text-body-normal text-muted-moss">
          Good Sheet is how we called our recycled plastic sheets. Available in
          various colors. Browse the options below to find your favorite ones!
        </p>
      </div>
      <div
        class="col-span-12 row-end-3 grid grid-cols-12 auto-rows-auto gap-x-custom-2xs gap-y-custom-xl max-md:grid-cols-2 max-md:gap-y-custom-m-l">
        {allColors.map((c) => <ColorCard color={c} />)}
      </div>
    </div>
  </section>
</BaseLayout>
