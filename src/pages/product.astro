---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import Button from "../components/Button.astro";

import signatureStool from "./../assets/signature-stool-1.jpeg";
import padelKeyChain from "./../assets/padel-keychain-1.jpeg";
import table from "./../assets/table-1.jpeg";

import { getCollection } from "astro:content";
import ProductCard from "../components/ProductCard.astro";
const allProducts = await getCollection("products");
---

<BaseLayout>
  <section id="product-header" class="section bg-warm-alabaster">
    <div class="wrapper pt-custom-xl pb-custom-2xl">
      <div
        class="col-span-6 col-end-7 flex flex-col justify-center items-start gap-custom-s">
        <h1
          class="text-heading-large max-w-text-heading-large text-deep-pine-charcoal">
          Our Product Collection
        </h1>
        <p class="max-w-text-body-normal text-muted-moss">
          Our products are produced and designed efficiently, with less waste,
          and easy to assemble, guided by principle that it should be useful and
          meaningful.
        </p>
      </div>
      <div
        class="col-span-6 col-end-13 flex justify-center items-center px-custom-2xl">
        <div class="flex-1">
          <Image
            class="w-auto h-1/3 aspect-auto ml-10 rotate-15 rounded-lg shadow-solid-green"
            src={table}
            priority
            alt="A red stool made from recycled plastic sheet"
          />
        </div>
        <div class="flex-1 z-1 -mx-custom-3xs">
          <Image
            class="w-auto h-3/4 aspect-auto rounded-lg shadow-solid-green"
            src={signatureStool}
            priority
            alt="A red stool made from recycled plastic sheet"
          />
        </div>
        <div class="flex-1">
          <Image
            class="w-auto h-1/3 aspect-auto -rotate-15 rounded-lg shadow-solid-green"
            src={padelKeyChain}
            priority
            alt="A red stool made from recycled plastic sheet"
          />
        </div>
      </div>
    </div>
  </section>
  <section id="cta-banner" class="section bg-blue">
    <div
      class="max-w-6xl mx-auto py-custom-s-m flex justify-between items-center gap-custom-2xl max-lg:flex-col max-lg:gap-custom-m max-md:mx-6 max-xl:mx-10 max-lg:pt-custom-s-m max-lg:pb-custom-m-l">
      <span class="font-body text-body-large font-normal text-pure-white"
        >Go to our marketplace to purchase our product or download our full
        catalogue for additional information</span
      >
      <div class="flex gap-custom-s">
        <Button>
          <a href=""> browse marketplace </a>
        </Button>
        <Button>
          <a href=""> download catalogue </a>
        </Button>
      </div>
    </div>
  </section>
  <section id="product-list" class="section bg-soft-sand">
    <div
      class="max-w-6xl mx-auto py-custom-l-xl flex flex-col gap-custom-s-l max-md:mx-6 max-xl:mx-10">
      <div class="flex justify-between items-center">
        <h2
          class="text-heading-small max-w-text-heading-small text-deep-pine-charcoal">
          Product Collections
        </h2>
        <div class="flex items-center">
          <div
            class="px-custom-m py-custom-2xs bg-green rounded-l-full border border-green font-body text-body-small font-extrabold text-pure-white">
            all products
          </div>
          <div
            class="px-custom-m py-custom-2xs bg-soft-sand border border-green font-body text-body-small text-deep-pine-charcoal">
            smaller things
          </div>
          <div
            class="px-custom-m py-custom-2xs bg-soft-sand rounded-r-full border border-green font-body text-body-small text-deep-pine-charcoal">
            larger things
          </div>
        </div>
      </div>
      <div
        class="grid grid-cols-12 auto-rows-auto gap-x-custom-2xs gap-y-custom-xl max-md:grid-cols-2 max-md:gap-y-custom-m-l">
        {allProducts.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>
</BaseLayout>
