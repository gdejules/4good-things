---
import "../styles/global.css";
import ProductSection from "../components/ProductSection.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Home</title>
  </head>
  <body>
    <a
      href="/"
      class="absolute top-4 left-4 text-sm text-gray-500 hover:text-gray-700"
      >Home</a
    >
    <a
      href="/about"
      class="absolute top-4 right-4 text-sm text-gray-500 hover:text-gray-700"
      >About</a
    >
    <a
      href="/product"
      class="absolute top-4 right-20 text-sm text-gray-500 hover:text-gray-700"
      >Product</a
    >
    <a
      href="/project"
      class="absolute top-4 right-36 text-sm text-gray-500 hover:text-gray-700"
      >Project</a
    >
    <div class="w-full px-24 pt-12 pb-14 bg-green min-h-screen">
      <div class="flex justify-between items-center gap-9">
        <div
          class="text-cream w-1/2 flex flex-col justify-center items-start gap-5">
          <h1>Good Things are Coming to You</h1>
          <p class="text-xl">
            What if waste——especially plastic——was not the end of a story, but
            the beginning of something new?
          </p>
          <a
            href="#about"
            class="flex-shrink-0 flex items-center mt-3 text-cream hover:text-orange hover:underline">
            <span class="font-mono text-sm uppercase">
              Explore More <span class="font-mono text-xl">↓</span>
            </span>
          </a>
        </div>
        <div class="w-1/2 h-screen relative">
          <img
            src="./src/assets/images/hero/aloha-table.jpeg"
            alt="Aloha Project recycled plastic table"
            class="absolute top-16 left-20 w-64 h-auto rounded-lg shadow-md"
          />
          <img
            src="./src/assets/images/hero/astha.jpeg"
            alt="Astha Project recycled plastic table"
            class="absolute top-4 right-8 w-48 h-auto rounded-lg shadow-md"
          />
          <img
            src="./src/assets/images/hero/padel.jpeg"
            alt="Recycled plastic padel racket keychain"
            class="absolute top-80 right-56 w-32 h-auto rounded-lg shadow-md"
          />
          <img
            src="./src/assets/images/hero/signature-stool.jpeg"
            alt="Recycled plastic stool"
            class="absolute top-72 left-1 w-48 h-auto rounded-lg shadow-md"
          />
          <img
            src="./src/assets/images/hero/signboard.jpeg"
            alt="Recycled plastic table signboard"
            class="absolute top-96 right-2 w-48 h-auto rounded-lg shadow-md"
          />
        </div>
      </div>
    </div>
    <div id="about" class="w-full h-auto mx-0 bg-green/[0.2]">
      <div class="container mx-auto py-12 flex flex-row justify-stretch gap-16">
        <div class="w-1/3 flex flex-col justify-center gap-12">
          <div>
            <span class="highlight text-orange block">5th in the world</span>
            <p class="text-xl">
              Indonesia is world's fifth-largest contributor to plastic waste in
              the ocean.
            </p>
          </div>
          <div>
            <span class="highlight text-orange block">60% is mismanaged</span>
            <p class="text-xl">
              More than 60% of the total plastic waste is mismanaged.
            </p>
          </div>
        </div>
        <div class="w-1/3 flex flex-col justify-center gap-4">
          <span class="highlight text-green block">
            4GoodThings is where plastic waste stops being trash and starts
            becoming something that matters.
          </span>
          <a href="./about">About Us</a>
        </div>
        <div class="w-1/3 flex flex-col justify-center gap-12">
          <div>
            <span class="highlight text-orange block">14.433 kg</span>
            <p class="text-xl">plastic waste recycled per November 2025</p>
          </div>
          <div>
            <span class="highlight text-orange block">3.946.667 pieces</span>
            <p class="text-xl">
              of mixed plastic bottle waste has been collected
            </p>
          </div>
        </div>
      </div>
    </div>
    <ProductSection />
    <div class="container mx-auto py-12 flex flex-row justify-stretch gap-16">
      <div class="w-1/3 flex flex-col justify-center gap-4">
        <img
          src="https://media.easy-peasy.ai/32c0c600-e4a8-4628-a345-e38a90f9f45c/bb7efe09-2bf1-4cc2-acc6-463ebfa7d90c.png"
          alt=""
        />
        <p class="text-2xl">Flower Pot</p>
        <p>9 kg plastic recycled</p>
      </div>
      <div class="w-1/3 flex flex-col justify-center gap-4">
        <img
          src="https://media.easy-peasy.ai/32c0c600-e4a8-4628-a345-e38a90f9f45c/bb7efe09-2bf1-4cc2-acc6-463ebfa7d90c.png"
          alt=""
        />
        <p class="text-2xl">Flower pot</p>
        <p>9 kg plastic recycled</p>
      </div>
      <div class="w-1/3 h-auto bg-cream flex flex-col justify-center gap-4">
        <span class="highlight text-green text-center"
          ><a href="/product">Explore More Smaller Things</a></span
        >
      </div>
    </div>
  </body>
</html>
