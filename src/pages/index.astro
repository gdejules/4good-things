---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Home</title>
  </head>
  <body>
    <a
      href="/"
      class="absolute top-4 left-4 text-sm text-gray-500 hover:text-gray-700"
      >Home</a
    >
    <a
      href="/about"
      class="absolute top-4 right-4 text-sm text-gray-500 hover:text-gray-700"
      >About</a
    >
    <a
      href="/product"
      class="absolute top-4 right-20 text-sm text-gray-500 hover:text-gray-700"
      >Product</a
    >
    <a
      href="/project"
      class="absolute top-4 right-36 text-sm text-gray-500 hover:text-gray-700"
      >Project</a
    >
    <div class="w-full mx-0 bg-cream min-h-screen">
      <div class="container mx-auto py-12 flex flex-row justify-stretch gap-4">
        <div
          class="text-green w-1/2 flex flex-col justify-center gap-4 min-h-[600px]">
          <h1>Good Things are Coming to You</h1>
          <p>
            What if waste — especially plastic—was not the end of a story, but
            the beginning of something new?
          </p>
          <button
            class="bg-transparent w-48 text-green rounded hover:bg-green-dark transition-colors duration-300">
            <a href="/about" class="block">Learn More</a>
          </button>
        </div>
        <div class="w-1/2 relative">
          <img
            src="./src/assets/images/hero/aloha-table.jpeg"
            alt="Aloha Project recycled plastic table"
            class="absolute top-16 left-24 w-64 h-auto rounded-lg shadow-md"
          />
          <img
            src="./src/assets/images/hero/astha.jpeg"
            alt="Astha Project recycled plastic table"
            class="absolute top-4 right-8 w-48 h-auto rounded-lg shadow-md"
          />
          <img
            src="./src/assets/images/hero/padel.jpeg"
            alt="Recycled plastic padel racket keychain"
            class="absolute top-80 right-64 w-32 h-auto rounded-lg shadow-md"
          />
          <img
            src="./src/assets/images/hero/signature-stool.jpeg"
            alt="Recycled plastic stool"
            class="absolute top-72 left-4 w-48 h-auto rounded-lg shadow-md"
          />
          <img
            src="./src/assets/images/hero/signboard.jpeg"
            alt="Recycled plastic table signboard"
            class="absolute top-80 right-4 w-48 h-auto rounded-lg shadow-md"
          />
        </div>
      </div>
    </div>
    <div></div>
  </body>
</html>
