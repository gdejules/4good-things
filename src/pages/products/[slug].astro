---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPrice, getProducts, getRelated } from "../../data/product.ts";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product, related: getRelated(products, product.slug) },
  }));
}

const { product, related } = Astro.props;
---

<BaseLayout>
  <section id="product-header" class="section bg-warm-alabaster">
    <div class="wrapper pt-custom-xl pb-custom-2xl">
      <div class="flex flex-col">
        <div>
          {product.name}
        </div>
        <div>
          {formatPrice(product.price)}
        </div>
        <div>
          {
            product.images.map((i) => (
              <div class="flex gap-2">
                <Image src={i.src} alt={i.alt} width="100" height="100" />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
