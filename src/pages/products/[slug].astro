---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPrice, getProducts, getRelated } from "../../data/product.ts";
import { Image } from "astro:assets";
import {
  SocialButton,
  SecondaryButton,
} from "../../components/CustomAwesomeButton";
import ProductCard from "../../components/ProductCard.astro";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product, related: getRelated(products, product.slug) },
  }));
}

const { product, related } = Astro.props;
const dimensionKeys = [
  "height",
  "length",
  "width",
  "diameter",
  "volume",
  "thickness",
];
const dimensionProps = Object.fromEntries(
  Object.entries(product).filter(([key]) => dimensionKeys.includes(key)),
);
const availableDimensionProps = Object.entries(dimensionProps).filter(
  ([_, value]) => {
    return value !== undefined && value !== null && value !== "";
  },
);
const contactButton = {
  children: "Contact us",
  sharer: {
    url: "https://play.google.com/store/apps/details?id=com.whatsapp&hl=en",
    message: "Check this out",
  },
  className: "product-detail",
  type: "whatsapp",
  size: "large",
  active: false,
};
const marketplaceButton = {
  children: "Buy product",
  href: "https://shopee.co.id/",
  className: "product-detail",
  size: "large",
  active: false,
};
const allProductsButton = {
  children: "See all",
  href: "/product",
  className: "all-products items-center",
  size: "large",
  active: false,
};
---

<BaseLayout>
  <section id="product-detail" class="section bg-warm-alabaster">
    <div class="wrapper pt-custom-l">
      <nav
        class="col-span-12 flex gap-custom-s font-body text-body-small uppercase tracking-widest"
        aria-label="Breadcrumb">
        <a href="/product" class="text-muted-moss hover:text-green"
          >All Products</a
        >
        <span aria-hidden="true">/</span>
        <span class="text-deep-pine-charcoal" aria-current="page"
          >{product.name}</span
        >
      </nav>
    </div>

    <div class="product-info wrapper pt-custom-l pb-custom-2xl">
      <div
        class="col-span-6 flex flex-col gap-custom-s max-md:col-span-1"
        data-product-gallery>
        <div
          class="relative aspect-square overflow-hidden rounded-lg bg-soft-sand">
          {
            product.images.map((image, index) => (
              <div
                class:list={["absolute inset-0", index !== 0 && "hidden"]}
                data-gallery-panel={index}>
                <Image
                  src={image.src}
                  alt={`${image.alt} — view ${index + 1}`}
                  width={1440}
                  height={1440}
                  format="webp"
                  loading={index === 0 ? "eager" : "lazy"}
                  class="h-full w-full object-cover"
                />
              </div>
            ))
          }
        </div>
        <div class="grid grid-cols-3 gap-custom-m">
          {
            product.images.map((image, index) => (
              <button
                type="button"
                class:list="aspect-square overflow-hidden bg-soft-sand transition-all"
                data-gallery-thumb={index}
                aria-label={`Show view ${index + 1}`}
                aria-pressed={index === 0 ? "true" : "false"}>
                <Image
                  src={image.src}
                  alt={image.alt}
                  width={360}
                  height={360}
                  format="webp"
                  loading="lazy"
                  class="h-full w-full object-cover rounded-md cursor-pointer"
                />
              </button>
            ))
          }
        </div>
      </div>

      <div
        class="col-start-8 col-span-5 flex flex-col gap-custom-m gap-max-lg:col-span-1">
        <div class="flex flex-col gap-custom-xs">
          <span
            class="text-muted-moss font-body text-body-normal font-normal uppercase tracking-wider"
            >{product.category}</span
          >
          <h1 class="text-deep-pine-charcoal text-heading-large">
            {product.name}
          </h1>
          <span class="text-blue font-body text-body-large font-bold"
            >{formatPrice(product.price)}</span
          >
          <div
            class="py-custom-xs px-custom-s border-l-4 border-green font-body text-body-normal font-normal text-deep-pine-charcoal">
            {product.shortDescription}
          </div>
        </div>
        <div
          class="text-deep-pine-charcoal font-body text-body-normal max-w-text-body-normal font-normal">
          {product.description}
        </div>
        <div class="flex gap-custom-m">
          <div class="flex-1 flex flex-col gap-custom-xs">
            <div
              class="text-muted-moss font-body text-body-normal font-medium tracking-wider uppercase">
              Impact
            </div>
            <div
              class="text-deep-pine-charcoal font-body text-body-normal font-medium">
              {`${product.recycledWeight} of plastic waste recycled`}
            </div>
          </div>
          <div class="flex-1 flex flex-col gap-custom-xs">
            <div
              class="text-muted-moss font-body text-body-normal font-medium tracking-wider uppercase">
              Dimension
            </div>
            <ul class="flex flex-col gap-custom-s">
              {
                availableDimensionProps.map(([key, value]) => (
                  <li class="flex gap-custom-s justify-between">
                    <div class="font-body text-body-normal font-normal text-muted-moss">
                      {key}
                    </div>
                    <div class="font-body text-body-normal font-medium text-deep-pine-charcoal">
                      {value}
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <div class="flex-1 flex flex-col gap-custom-xs">
          <div
            class="text-muted-moss font-body text-body-normal font-medium tracking-wider uppercase">
            Additional Information
          </div>
          <ul
            class="text-deep-pine-charcoal font-body text-body-normal font-normal flex flex-col gap-custom-xs">
            <li>
              Size & thickness tolerance within 2-3mm from measurement above
            </li>
            <li>
              Contact us if you have any required custom sized, color & quantity
            </li>
          </ul>
        </div>
        <div class="flex gap-custom-s">
          <SocialButton
            client:load
            sharer={contactButton.sharer}
            type={contactButton.type}
            active={contactButton.active}
            size={contactButton.size}
            className="nav">
            {contactButton.children}
          </SocialButton>
          <SecondaryButton
            client:load
            href={marketplaceButton.href}
            active={marketplaceButton.active}
            size={marketplaceButton.size}>
            {marketplaceButton.children}
          </SecondaryButton>
        </div>
        <span class="text-muted-moss font-body text-body-small font-normal"
          >CONTACT US FOR MORE INFORMATION OR VISIT OUR MARKETPLACE FOR DIRECT
          PURCHASE.</span
        >
      </div>
    </div>

    <div class="product-info">
      <div
        class="max-w-6xl mx-auto py-custom-l-xl flex flex-col gap-custom-l-xl max-md:mx-6 max-xl:mx-10">
        <h2
          class="text-heading-medium max-w-text-heading-medium text-deep-pine-charcoal">
          Other related products
        </h2>
        <div
          class="grid grid-cols-12 auto-rows-auto gap-x-custom-s gap-y-custom-xl max-md:grid-cols-2 max-md:gap-y-custom-m-l">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
        <div class="flex justify-center">
          <SecondaryButton
            client:load
            href={allProductsButton.href}
            active={allProductsButton.active}
            size={allProductsButton.size}>
            {allProductsButton.children}
          </SecondaryButton>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener("astro:page-load", () => {
      const gallery = document.querySelector("[data-product-gallery]");
      if (gallery) {
        const panels = Array.from(
          gallery.querySelectorAll("[data-gallery-panel]"),
        );
        const thumbs = Array.from(
          gallery.querySelectorAll("[data-gallery-thumb]"),
        );

        thumbs.forEach((thumb) => {
          thumb.addEventListener("click", () => {
            const active = thumb.dataset.galleryThumb;
            panels.forEach((panel) =>
              panel.classList.toggle(
                "hidden",
                panel.dataset.galleryPanel !== active,
              ),
            );
            thumbs.forEach((button) => {
              const selected = button.dataset.galleryThumb === active;
              button.classList.toggle("ring-ink", selected);
              button.classList.toggle("ring-line", !selected);
              button.setAttribute("aria-pressed", selected ? "true" : "false");
            });
          });
        });
      }
    });
  </script>
</BaseLayout>
