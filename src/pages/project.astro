---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
---

<BaseLayout>
  <Navigation />
  <div class="h-screen bg-cream flex-items-center justify-start p-16">
    <h2 class="text-green mb-4">
      What if waste — especially plastic—was not the end of a story, but the
      beginning of something new?
    </h2>
    <h1 class="text-black">
      4GoodThings is where plastic waste stops being trash and starts becoming
      something that matters.
    </h1>
  </div>
</BaseLayout>
