---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";

import alohaTable from "./../assets/collab/aloha/aloha-table1.jpeg";
import prasmulSign from "./../assets/prasmul-signage.jpg";
import petronasRack from "./../assets/collab/petronas/petronas-rack1.png";

import { getCollection } from "astro:content";
import CollaborathingList from "../components/CollaborathingList.astro";
const allCollaborathings = await getCollection("projects", ({ data }) => {
  return data.type === "Collaborathing";
});
const allGeneralProjects = await getCollection("projects", ({ data }) => {
  return data.type === "General Project";
});
---

<BaseLayout>
  <section id="project-header" class="section bg-warm-alabaster">
    <div class="wrapper grid-rows-1 auto-rows-auto py-custom-xl">
      <div
        class="col-span-6 col-end-7 flex flex-col justify-center items-start gap-custom-s">
        <h1
          class="text-heading-large max-w-text-heading-large text-deep-pine-charcoal">
          Our Projects
        </h1>
        <p class="max-w-text-body-normal text-muted-moss">
          We are actively collaborating with brands and instances to inspire
          environmental and sustainable practices. Here are how we help our
          collaborators in their circular economy journey.
        </p>
      </div>
      <div
        class="col-span-6 col-end-13 flex justify-center items-center px-custom-2xs-xl">
        <div class="flex-1">
          <Image
            class="w-auto h-1/3 aspect-auto rotate-15 rounded-lg shadow-solid-green"
            src={petronasRack}
            priority
            alt="A red stool made from recycled plastic sheet"
          />
        </div>
        <div class="flex-1 z-1 -mx-custom-3xs">
          <Image
            class="w-full h-auto aspect-auto rounded-lg shadow-solid-green"
            src={alohaTable}
            priority
            alt="A red stool made from recycled plastic sheet"
          />
        </div>
        <div class="flex-1">
          <Image
            class="w-auto h-1/3 aspect-auto -rotate-15 rounded-lg shadow-solid-green"
            src={prasmulSign}
            priority
            alt="A red stool made from recycled plastic sheet"
          />
        </div>
      </div>
    </div>
  </section>
  <section id="collaborathings" class="section bg-forest-shadow">
    <div class="wrapper grid-rows-1 auto-rows-auto py-custom-xl">
      <div class="col-span-12 row-end-2 flex flex-col gap-custom-xs-s">
        <h2
          class="text-heading-medium max-w-text-heading-medium text-pure-white">
          Collaborathing
        </h2>
        <p class="max-w-text-body-normal text-cream">
          These are where journeys of circular economy happened. We were working
          closely with our partner, from thrash gathering all the way to custom
          product design, tailored to our partners’ needs.
        </p>
      </div>
      <div
        class="col-span-12 row-end-3 grid grid-cols-12 auto-rows-auto gap-x-custom-2xs gap-y-custom-xl">
        {
          allCollaborathings.length > 0 ? (
            allCollaborathings.map((p) => <CollaborathingList project={p} />)
          ) : (
            <p class="col-start-1 col-span-12 font-body text-body-normal text-muted-moss my-custom-xl">
              No collaborathing project available yet.
            </p>
          )
        }
      </div>
    </div>
  </section>
  <section id="general-projects" class="section bg-warm-alabaster">
    <div class="wrapper grid-rows-1 auto-rows-auto py-custom-xl">
      <div class="col-span-12 row-end-2 flex flex-col gap-custom-xs-s">
        <h2
          class="text-heading-medium max-w-text-heading-medium text-deep-pine-charcoal">
          General Project
        </h2>
        <p class="max-w-text-body-normal text-muted-moss">
          Our projects bring our recycling initiative and product design to help
          various institution and brands achieve their environmental and
          sustainability goals.
        </p>
      </div>
      <div></div>
    </div>
  </section>
</BaseLayout>
