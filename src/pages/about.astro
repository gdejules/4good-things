---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import { Image } from "astro:assets";
import OurValues from "../components/OurValuesTabs";
import {
  SocialButton,
  DownloadButton,
} from "../components/CustomAwesomeButton";

const contactButton = {
  children: "Contact us",
  sharer: {
    url: "https://play.google.com/store/apps/details?id=com.whatsapp&hl=en",
    message: "Check this out",
  },
  className: "about-cta",
  type: "whatsapp",
  size: "large",
  active: false,
};
const downloadButton = {
  children: "Catalogue",
  href: "/downloads/REV-1 Catalogue 4GoodThings.pdf",
  download: "Product Catalogue",
  className: "download",
  size: "large",
  active: false,
};

import headerBackground from "./../assets/prasmul-main.jpeg";
import thrashShreds from "./../assets/thrash-shreds.jpeg";
import alohaTableDisplay from "./../assets/aloha-table-display.jpeg";
import circularFirst from "./../assets/circular-first.png";
import circularSecond from "./../assets/circular-second.png";
import circularThird from "./../assets/circular-third.png";
import ladderFirst from "./../assets/r-Ladder-rethink.png";
import ladderSecond from "./../assets/r-Ladder-reduce.png";
import ladderThird from "./../assets/r-Ladder-reuse-repurpose.png";
import ladderFourth from "./../assets/r-Ladder-recycle.png";
import sdgFirst from "./../assets/E_SDG_Icons-14.jpg";
import sdgSecond from "./../assets/E_SDG_Icons-15.jpg";
import sdgThird from "./../assets/E_SDG_Icons-12.jpg";
import sdgFourth from "./../assets/E_SDG_Icons-08.jpg";
import alohaPlasticSort from "./../assets/aloha-plastic-sort-3.jpeg";
import alohaPlasticShreds from "./../assets/aloha-plastic-shreds.jpeg";
import alohaTableDisplayTwo from "./../assets/aloha-table-6.jpeg";
import alohaStaffs from "./../assets/aloha-plastic-sort-7.jpeg";

const optimizedBg = await getImage({
  src: headerBackground,
  format: "webp", // Optional: Force a format like webp or avif
  quality: 80, // Optional: Set optimization quality
  width: 1440, // Optional: Specify required fallback width
});

const craftedOne = {
  src: (await getImage({ src: alohaPlasticSort })).src,
  alt: "plastic sorting",
};

const craftedTwo = {
  src: (await getImage({ src: alohaPlasticShreds })).src,
  alt: "plastic shreds ready for processing",
};

const purposeOne: { src: string; alt: string } = {
  src: (await getImage({ src: alohaTableDisplayTwo })).src,
  alt: "aloha table display made from recycled plastic",
};

const purposeTwo = {
  src: (await getImage({ src: alohaStaffs })).src,
  alt: "a group of people take a picture together with sorted thrash",
};

// Wrap optimized images with alt text for component props
const sdgImagesOptimized: Array<{
  image: { src: string; alt: string };
  content: string;
}> = [
  {
    image: {
      src: (await getImage({ src: sdgFirst })).src,
      alt: "fourteenth pillar of sustainable development goals",
    },
    content:
      "Turning plastic waste into valuable goods before it goes to the ocean.",
  },
  {
    image: {
      src: (await getImage({ src: sdgSecond })).src,
      alt: "fifteenth pillar of sustainable development goals",
    },
    content: "Reducing the plastic waste dumped to the landfills.",
  },
  {
    image: {
      src: (await getImage({ src: sdgThird })).src,
      alt: "twelveth pillar of sustainable development goals",
    },
    content: "Educate people to be responsible with their plastic consumption.",
  },
  {
    image: {
      src: (await getImage({ src: sdgFourth })).src,
      alt: "eighth pillar of sustainable development goals",
    },
    content:
      "Help local communities to contribute creating impact by being a part of 4GoodThings.",
  },
];

const circular = [
  {
    title: "Consumption, Use, Reuse, Repair · Collection · Recycling",
    content:
      "Cutting waste from the systems which end up in landfill or ocean with selective collection system",
    image: circularFirst,
    alt: "circular economy diagram",
  },
  {
    title: "Design · Production, Remanufacturing",
    content:
      "Transforming the plastic waste into durable and valuable goods through customized product design",
    image: circularSecond,
    alt: "circular economy diagram",
  },
  {
    title: "Distribution",
    content:
      "Distributing the products and give plastics a second life, third life, and so on through reuse and repair initiatives",
    image: circularThird,
    alt: "circular economy diagram",
  },
];

const rLadder = [
  {
    title: "Rethink",
    content: "Turning plastic waste into functional and durable goods",
    image: ladderFirst,
    alt: "r-ladder diagram",
  },
  {
    title: "Reduce",
    content:
      "Efficiency in product designing and production through maximizing pattern and design",
    image: ladderSecond,
    alt: "r-ladder diagram",
  },
  {
    title: "Reuse and Repurpose",
    content:
      "Utilizing production waste from CNC cutting and hot press machine as raw materials",
    image: ladderThird,
    alt: "r-ladder diagram",
  },
  {
    title: "Recycle",
    content: "Recycle plastic waste into valuable goods",
    image: ladderFourth,
    alt: "r-ladder diagram",
  },
];
---

<BaseLayout>
  <section
    id="about-header"
    class="relative min-h-screen w-full bg-cover bg-center bg-no-repeat flex items-end"
    style={`background-image: url('${optimizedBg.src}');`}>
    <div
      class="absolute inset-0 bg-linear-to-b from-warm-alabaster via-transparent to-forest-shadow">
      <div class="wrapper h-full grid-rows-2 py-custom-xl max-md:justify-end">
        <div
          class="col-span-8 col-end-11 row-end-3 flex flex-col justify-start items-center gap-custom-s">
          <h1
            class="text-heading-super max-w-text-heading-super text-pure-white text-center">
            A mission from a curiosity
          </h1>
          <p class="max-w-text-body-normal text-cream text-center">
            Our journey began with questions: Is plastic waste actually
            valuable? Could it be transformed into something useful instead of
            polluting our environment?
          </p>
        </div>
      </div>
    </div>
  </section>
  <section id="about-highlight" class="section bg-forest-shadow">
    <div class="wrapper auto-rows-auto py-custom-3xl">
      <div
        class="col-span-10 col-end-12 flex flex-col items-center gap-custom-xs py-custom-l-xl">
        <h2
          class="who font-body font-medium text-body-large text-center uppercase text-cream">
          Who we are
        </h2>
        <h3
          class="about-oneline text-heading-large max-w-text-heading-large tracking-wider text-pure-white text-center">
          a movement to transform plastic waste into meaningful products
        </h3>
      </div>
      <div
        class="col-span-12 grid grid-cols-10 gap-custom-m items-center py-custom-l-xl max-sm:flex max-sm:flex-col">
        <Image
          class="col-span-4 row-end-2 col-end-5 max-sm:w-2/3 max-sm:h-auto"
          src={thrashShreds}
          alt="Plactic glass trash"
        />
        <span
          class="col-span-5 row-end-2 col-end-11 font-body text-body-large max-w-text-body-large font-normal text-pure-white">
          Just 6 kilometers from our workshop stands Bantar Gebang, the largest
          landfill in Indonesia. This uncomfortable reality raised many
          questions that we end up digging further.
        </span>
      </div>
      <div
        class="col-span-12 grid grid-cols-10 gap-custom-m items-center py-custom-l-xl max-sm:flex max-sm:flex-col">
        <Image
          class="col-span-4 row-end-2 col-end-11 max-sm:w-2/3 max-sm:h-auto"
          src={alohaTableDisplay}
          alt="Plactic glass trash"
        />
        <span
          class="col-span-5 row-end-2 col-end-6 font-body text-body-large max-w-text-body-large font-normal text-pure-white">
          4GoodThings was born from the belief that waste can have purpose. We
          strive to turn plastic into meaningful products and create real impact
          for our environment and community.
        </span>
      </div>
    </div>
  </section>
  <section id="about-principles" class="section bg-forest-shadow">
    <div class="wrapper auto-rows-auto py-custom-3xl">
      <div class="col-span-12 flex flex-col gap-custom-xs py-custom-s-m">
        <h2
          class="principle font-body font-medium text-body-large uppercase text-cream text-center">
          Our principles
        </h2>
        <h3
          class="principle-title text-heading-large max-w-text-heading-large tracking-wider text-pure-white text-center">
          rooted in circular and sustainable practices
        </h3>
      </div>
      <div
        class="pin-circular-section h-screen relative col-span-12 grid grid-cols-10 grid-rows-[auto_auto] gap-x-custom-2xs gap-y-custom-s-m items-center my-custom-m max-sm:flex max-sm:w-full">
        <div
          class="diagrams relative col-span-5 col-end-6 row-start-1 row-end-3 aspect-square w-full max-sm:hidden">
          {
            circular.map(({ image, alt }) => (
              <div class="slide-circular absolute inset-0 opacity-0 invisible">
                <Image class="" src={image} alt={alt} />
              </div>
            ))
          }
        </div>
        <div
          class="circular articles relative col-span-5 col-end-11 row-start-1 row-end-3 flex flex-col gap-custom-m">
          <div class="fill-circular absolute inset-y-0 left-0 w-1 bg-cream">
          </div>
          {
            circular.map(({ title, content }) => (
              <div class="list-circular flex flex-col gap-custom-xs ml-custom-m text-muted-moss">
                <p class="font-body font-bold text-body-large max-w-text-body-large">
                  {title}
                </p>
                <p class="font-body font-normal text-body-normal max-w-text-body-normal">
                  {content}
                </p>
              </div>
            ))
          }
        </div>
      </div>
      <div
        class="pin-ladder-section h-screen relative col-span-12 grid grid-cols-10 gap-x-custom-2xs gap-y-custom-s-m items-center my-custom-m max-sm:flex max-sm:w-full">
        <div
          class="ladder articles relative col-span-5 col-end-6 flex flex-col gap-custom-m">
          <div class="fill-ladder absolute inset-y-0 left-0 w-1 bg-cream"></div>
          {
            rLadder.map(({ title, content }) => (
              <div class="list-ladder flex flex-col gap-custom-xs ml-custom-m text-muted-moss">
                <p class="font-body font-bold text-body-large max-w-text-body-large">
                  {title}
                </p>
                <p class="font-body font-normal text-body-normal max-w-text-body-normal">
                  {content}
                </p>
              </div>
            ))
          }
        </div>
        <div
          class="diagrams relative col-span-5 col-end-11 aspect-2/3 w-full max-sm:hidden">
          {
            rLadder.map(({ image, alt }) => (
              <div class="slide-ladder absolute inset-0 opacity-0 invisible">
                <Image
                  class="h-full w-full object-contain"
                  src={image}
                  alt={alt}
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
  <section id="about-values" class="section bg-soft-sand">
    <div class="wrapper auto-rows-auto py-custom-3xl">
      <div class="col-span-12 flex flex-col gap-custom-xs py-custom-s-m">
        <h2
          class="principle font-body font-medium text-body-large uppercase text-muted-moss text-center">
          Our values
        </h2>
        <h3
          class="principle-title text-heading-large max-w-text-heading-large tracking-wider text-deep-pine-charcoal text-center">
          #crafted4purpose
        </h3>
      </div>
      <OurValues
        client:load
        craftedOne={craftedOne}
        craftedTwo={craftedTwo}
        sdg={sdgImagesOptimized}
        purposeOne={purposeOne}
        purposeTwo={purposeTwo}
      />
    </div>
  </section>
  <section id="about-cta" class="section bg-soft-sand">
    <div class="wrapper auto-rows-auto py-custom-3xl">
      <div
        class="col-span-8 col-end-11 flex flex-col gap-custom-xs items-center">
        <h2
          class="text-heading-large max-w-text-heading-large tracking-wider text-deep-pine-charcoal text-center">
          TOGETHER WE CAN DRIVE A better FUTURE
        </h2>
        <p
          class="text-body-large max-w-text-body-large text-muted-moss text-center">
          We can help you to bring your sustainability ideas to life. Contact us
          for collaboration or check our catalog for product inquiries. Let’s
          start your circular economy journey for the environment and community.
        </p>
        <div class="flex gap-custom-s py-custom-l-m max-sm:flex-col">
          <SocialButton
            client:load
            sharer={contactButton.sharer}
            type={contactButton.type}
            active={contactButton.active}
            size={contactButton.size}
            className={contactButton.className}>
            {contactButton.children}
          </SocialButton>
          <DownloadButton
            client:load
            href={downloadButton.href}
            active={downloadButton.active}
            size={downloadButton.size}>
            {downloadButton.children}
          </DownloadButton>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { gsap } from "gsap/gsap-core";
  import { ScrollTrigger } from "gsap/all";

  gsap.registerPlugin(ScrollTrigger);

  function initAbout() {
    const aboutPage = document.getElementById("about-header");
    if (!aboutPage) return;

    const fillCircular = document.querySelector(".fill-circular");
    const contentCircular = gsap.utils.toArray<HTMLElement>(".list-circular");
    const slidesCircular = gsap.utils.toArray<HTMLElement>(".slide-circular");

    const tlCircular = gsap.timeline({
      scrollTrigger: {
        trigger: ".pin-circular-section",
        start: "top top",
        end: "+=" + contentCircular.length * 50 + "%",
        pin: true,
        scrub: true,
        markers: false,
      },
    });

    fillCircular &&
      gsap.set(fillCircular, {
        scaleY: 1 / contentCircular.length,
        transformOrigin: "top left",
      });

    contentCircular.forEach((item, i) => {
      const previousItem = contentCircular[i - 1];
      if (previousItem) {
        tlCircular
          .set(item, { color: "var(--color-pure-white)" }, 0.5 * i)
          .to(
            slidesCircular[i],
            {
              autoAlpha: 1,
              duration: 0.2,
            },
            "<",
          )
          .set(previousItem, { color: "var(--color-muted-moss)" }, "<")
          .to(
            slidesCircular[i - 1],
            {
              autoAlpha: 0,
              duration: 0.2,
            },
            "<",
          );
      } else {
        gsap.set(item, { color: "var(--color-pure-white)" });
        gsap.set(slidesCircular[i], { autoAlpha: 1 });
      }
    });
    tlCircular
      .to(
        fillCircular,
        {
          scaleY: 1,
          transformOrigin: "top left",
          ease: "none",
          duration: tlCircular.duration(),
        },
        0,
      )
      .to({}, {}); // add a small pause at the end of the timeline before it un-pins

    const fillLadder = document.querySelector(".fill-ladder");
    const contentLadder = gsap.utils.toArray<HTMLElement>(".list-ladder");
    const slidesLadder = gsap.utils.toArray<HTMLElement>(".slide-ladder");

    if (fillLadder) {
      console.log("start animate r-ladder diagram");
    } else return;

    const tlLadder = gsap.timeline({
      scrollTrigger: {
        trigger: ".pin-ladder-section",
        start: "top top",
        end: "+=" + contentLadder.length * 50 + "%",
        pin: true,
        scrub: true,
        markers: false,
      },
    });

    fillLadder &&
      gsap.set(fillLadder, {
        scaleY: 1 / contentLadder.length,
        transformOrigin: "top left",
      });

    contentLadder.forEach((item, i) => {
      const previousItem = contentLadder[i - 1];
      if (previousItem) {
        tlLadder
          .set(item, { color: "var(--color-pure-white)" }, 0.5 * i)
          .to(
            slidesLadder[i],
            {
              autoAlpha: 1,
              duration: 0.2,
            },
            "<",
          )
          .set(previousItem, { color: "var(--color-muted-moss)" }, "<")
          .to(
            slidesLadder[i - 1],
            {
              autoAlpha: 0,
              duration: 0.2,
            },
            "<",
          );
      } else {
        gsap.set(item, { color: "var(--color-pure-white)" });
        gsap.set(slidesLadder[i], { autoAlpha: 1 });
      }
    });
    tlLadder
      .to(
        fillLadder,
        {
          scaleY: 1,
          transformOrigin: "top left",
          ease: "none",
          duration: tlLadder.duration(),
        },
        0,
      )
      .to({}, {}); // add a small pause at the end of the timeline before it un-pins
  }

  document.removeEventListener("astro:page-load", initAbout); // astro:page-load
  document.addEventListener("astro:page-load", initAbout); // astro:page-load
</script>
