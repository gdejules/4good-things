{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", "src", "types"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "react-tilt-button": ["/types/react-tilt-button.d.ts"]
    },
    "typeRoots": ["./types", "./node_modules/@types"]
  }
}
